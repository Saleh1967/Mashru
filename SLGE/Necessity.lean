import SLGE.Root

/-!
# قانونُ الاستنفاد: الدرجةُ بعد استنفادها لا تكتمل، فتُلجئ إلى ما فوقها

صورةُ كلّ درجة: (١) تُستنفد عدًّا، (٢) يُفحص الحدُّ الأدنى المكتمل على المستنفَد كلِّه، (٣) فإن لم يتحقّق
فهذا وحده يرخّص الدرجةَ التالية.

**المكتمل (المعلن هنا):** ما يُبتدأ به ويوصَل ويوقَف عليه. والوقفُ يُسكِّن آخرَ المتحرّك (‎waqfForm‎)،
فالمكتملُ ما رخّصه القانونُ بعد تسكين آخره.

ما في هذا الملفّ درجاتُ الدالّ وحدها (من حيث هي). وما فوقها — استقلالُ المعنى، والأدواتُ والضمائرُ والإشارةُ وما بعدها —
وضعٌ لا يُستخرج من الدالّ وحده، ويحتاج مودَعًا من نوع «وضع».
-/

namespace SLGE
namespace Law

/-- **الوقف:** يُسكَّن آخرُ المتحرّك. -/
def waqfForm : List Nat → List Nat
  | [] => []
  | [a] => if a < 116 ∧ a % 4 < 3 then [4 * (a / 4) + 3] else [a]
  | a :: l => a :: waqfForm l

/-- **الحدُّ الأدنى المكتمل:** يُبتدأ به (القانون من الحالة ‎0‎)، ويوصَل (الانتقالاتُ)، ويوقَف عليه بعد التسكين. -/
def complete' (l : List Nat) : Bool := Fwaqf (run 0 (waqfForm l))

/-- **الصامتُ لا يكتمل بلا صائت:** الخانةُ الساكنةُ وحدَها لا يُبتدأ بها. -/
theorem nec_vowel : ∀ c < 29, run 0 [4 * c + 3] = 96 := by decide +kernel

/-- **الابتداءُ لا يكفي، ولا الوصلُ، فيلزم الوقف — والخانةُ الواحدةُ لا تكتمل بعد استنفادها:**
من ‎116‎ خانةً يُبتدأ بـ‎84‎، ولا تكتمل واحدةٌ منها. -/
theorem nec_second :
    ((List.range 116).filter fun a => Fwaqf (run 0 [a])).length = 84 ∧
    ((List.range 116).filter fun a => complete' [a]).length = 0 := by decide +kernel

/-- **وبالخانة الثانية يكتمل الدالّ:** ‎9,520‎ سلسلةً من خانتين مكتملة (من ‎13,456‎). -/
theorem two_complete :
    (((List.range 116).flatMap fun a => (List.range 116).map fun b => [a, b]).filter complete').length = 9520 := by
  decide +kernel

/-- **الحاملُ وحده لا يكفي، فيلزم الترتيب:** «كتب» و«بكت» جذران مرخَّصان مختلفان بالحوامل نفسِها
(ك=8، ت=18، ب=26). (مبرهنٌ على الشاهد.) -/
theorem nec_order : Mroot.Lic 0 [8, 18, 26] ∧ Mroot.Lic 0 [26, 8, 18] ∧ [8, 18, 26] ≠ [26, 8, 18] ∧
    ∀ c < 29, [8, 18, 26].count c = [26, 8, 18].count c := by
  refine ⟨⟨by decide, by decide⟩, ⟨by decide, by decide⟩, by decide, by decide⟩

/-- **والترتيبُ وحده لا يكفي، فيلزم الموضع (الحالة في الوزن):** الجذرُ نفسُه بترتيبه على وزنين
‎كَتَبَ‎ و‎كُتِبَ‎ سلسلتان مرخَّصتان مختلفتان. (مبرهنٌ على الشاهد.) -/
theorem nec_position :
    rootChain [8, 18, 26] [0, 0] ≠ rootChain [8, 18, 26] [1, 2] ∧
    Fwasl (run 0 (rootChain [8, 18, 26] [0, 0])) = true ∧ Fwasl (run 0 (rootChain [8, 18, 26] [1, 2])) = true := by
  decide

end Law
end SLGE
