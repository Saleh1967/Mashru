/-
  Jisr/Nisab.lean — النِّسَب الثلاث على علاقات أطر المالك، واستنفاد أساليب الإخبار في جدول العوامل.

  النصّ: الشخصية الإسلامية ج3 (مرشَّحٌ غير مختوم؛ السطر 721 في النصّ المحوَّل): «وضعت ليفيد الوضع النسب الإسنادية، أو التقييدية،
  أو الإضافية، بين المفردات، بضم بعضها إلى بعض، كالفاعلية، والمفعولية، وغيرهما». والمالك كان يسمّي الثالثة «التضمينية»؛
  وسُئل (2026-10-16): «الاسم: الإضافية (ج3) أم التضمينية (أنت)، وإمضاء التعيين أو تعديله» فأجاب «موافق» — فُهم إمضاءً
  للبناء على لفظ النصّ وللتعيين أدناه؛ فإن أراد «التضمينية» اسمًا فليقل، والاسمان هنا لشيء واحد.

  التعيين على علاقات المالك (`SLGE.Simat.semOf`: 1 مسند إليه، 2 مسند، 3 فاعلية، 4 مفعولية، 5 تعلّق، 6 عامل) — قرارٌ معلَن
  بتفويض المالك (2026-10-16) لا نقلٌ عن النصّ: الإسنادية = المسند والمسند إليه والفاعل (الفاعلُ مسندٌ إليه في الفعلية)؛
  التقييدية = المفعولية (قيدٌ على الإسناد)؛ الإضافية = التعلّق (المجرورُ والمتعلَّقُ المقدَّر — والجارُّ عاملٌ لا نسبةَ له عند
  المالك: `semOf 5 = 6`؛ ولا «إضافةَ» (مضاف إليه) في أدوار أطر المالك)؛ والعاملُ لا نسبةَ له. المبرهنات أدناه على هذا القرار
  فوق أطر المالك وعلاقاته.

  أساليب الإخبار: عمود «الأسلوب النحويّ» في مودَع العوامل المئة (`Jisr/AwamilUslub.lean` مولَّد منه): الخبر 82، والإنشاء 18
  (الطلب 2، التمني 1، الترجي 1، الاستفهام 10، النداء 4) — فاستنفادُ الإخبار في الجدول 82 عاملًا، وترخيصُ الأساليب الإنشائية
  لاحقٌ بقرار المالك («قبل الانتقال لترخيص الأساليب الإنشائية»).
-/
import SLGE.Simat
import Jisr.AwamilUslub

namespace Jisr
namespace Nisab
open SLGE.Tarkib SLGE.Simat

/-- النِّسَب الثلاث (ج3 السطر 721): الإسنادية، التقييدية، الإضافية (= «التضمينية» بتسمية المالك). -/
inductive Nisba | isnadiyya | taqyidiyya | idafiyya
deriving DecidableEq, Repr

/-- التعيين على علاقات المالك (`semOf`) — قرار معلَن. -/
def nisbaOf : Nat → Option Nisba
  | 1 | 2 | 3 => some .isnadiyya
  | 4 => some .taqyidiyya
  | 5 => some .idafiyya
  | _ => none

/-- **كلّ موضعٍ في كلّ إطارٍ عند المالك إمّا له نسبةٌ من الثلاث وإمّا عاملٌ** (لا موضعَ بلا تعيين). -/
theorem kull_mawdi : framesL.all (fun f => f.2.2.all fun x =>
    (nisbaOf (semOf x.1)).isSome || semOf x.1 == 6) = true := by decide +kernel

/-- **مركز الجملة الإسناد:** الإطار فيه موضعٌ نسبتُه إسنادية إذا وفقط إذا لم يكن شبهَ جملة (البنية 2) — وهو قول المالك
في Category: «إمّا فيه إسنادٌ … وإمّا لا إسنادَ فيه ويتعلّق بمسنَدٍ مقدَّر (شبهُ جملة)». الأطر 298، منها شبهُ جملة 2. -/
theorem isnad_markaz :
    framesL.all (fun f => (f.1 != 2) == (f.2.2.any fun x => nisbaOf (semOf x.1) == some .isnadiyya)) = true ∧
    framesL.length = 298 ∧ (framesL.filter fun f => f.1 == 2).length = 2 := by decide +kernel

/-- أعداد المواضع بنِسَبها في أطر المالك كلّها (إسنادية، تقييدية، إضافية، عامل) — من `#eval` قبل كتابتها. -/
def ihsa : List Nat :=
  [some Nisba.isnadiyya, some .taqyidiyya, some .idafiyya, none].map fun n =>
    (framesL.flatMap fun f => f.2.2.filter fun x => nisbaOf (semOf x.1) == n).length

theorem ihsa_val : ihsa = [736, 240, 4, 224] ∧ ihsa.sum = 1204 ∧ (framesL.flatMap (·.2.2)).length = 1204 := by
  decide +kernel

/-! ## أساليب الإخبار والإنشاء في جدول العوامل المئة -/

/-- الأساليب الواردة في عمود «الأسلوب النحويّ» بلفظها. -/
def asalib : List String := ["الخبر", "الطلب", "التمني", "الترجي", "الاستفهام", "النداء"]

/-- **استنفاد الأساليب في الجدول:** الستّة تستغرق المئة؛ الخبر 82، والإنشاء (الطلب، التمني، الترجي، الاستفهام، النداء) 18. -/
theorem uslub_istinfad :
    (asalib.map fun u => (Awamil.uslub.filter (·.2 == u)).length) = [82, 2, 1, 1, 10, 4] ∧
    Awamil.uslub.all (fun r => asalib.contains r.2) = true ∧ Awamil.uslub.length = 100 := by decide

/-- أساليب الإخبار في الجدول 82 عاملًا؛ والإنشائية 18 — ترخيصها لاحق. -/
theorem ikhbar_82 : (Awamil.uslub.filter (·.2 == "الخبر")).length = 82 ∧
    (Awamil.uslub.filter (·.2 != "الخبر")).length = 18 := by decide

end Nisab
end Jisr
