import Jisr.Intrubiya

/-!
# شهادةُ حدَّي معدّل نموّ القانون (مولَّد — لا يُحرَّر يدويًّا)

مولَّدٌ بـ`python3 -I scripts/bina_intrubiya_shahada.py`، ويطابقه `tahaqquq/test_intrubiya.py` بالبايت. المتّجهان مقرَّبان من متّجه بيرون
للحالات الحيّة، وصحّتُهما مفحوصةٌ هنا بـ`decide +kernel` لا بالتقريب.

- **الأعلى:** `10000^n · N_n ≤ 1 · 1057244^n · v₀` لكلّ `n` (`lawCount_aala`).
- **الأدنى:** `1 · 1057242^n · u₀ ≤ 10000^n · N_(4+n)` لكلّ `n` (`lawCount_adna`).

فمعدّلُ النموّ بين `1057242/10000` و`1057244/10000`، ولوغاريتمُه (الإنتروبيا الطوبولوجيّة للقانون بالبتّ) يُحسب خارج Lean.
وقيمُ `N_n` حتى 4 مبرهنةٌ على الشاهد (`adad_waqf`، `adad_wasl`).
-/

namespace Jisr.Intrubiya

open Nabt.Law

def shahadaV : List Nat := [790559154238, 1000001000000, 992523460035, 992523460035, 798036694203, 1000000, 28235219794, 28235219794, 1000000, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 1000000, 1000000, 790559154238, 28235219794, 28235219794, 1000000, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 28235219794, 762324934444, 762324934444, 790559154238, 762324934444, 762324934444, 762324934444, 762324934444, 790559154238, 790559154238, 762324934444, 762324934444, 790559154238, 790559154238, 790559154238, 790559154238, 790559154238, 734090714650, 734090714650, 734090714650, 734090714650, 734090714650, 734090714650, 734090714650, 734090714650, 734090714650, 790559154238, 762324934444, 762324934444, 790559154238, 0]

def shahadaU : List Nat := [110116719, 139289841, 138248295, 138248295, 111158264, 0, 3932739, 3932739, 0, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 0, 0, 110116719, 3932739, 3932739, 0, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 3932739, 106183979, 106183979, 110116719, 106183979, 106183979, 106183979, 106183979, 110116719, 110116719, 106183979, 106183979, 110116719, 110116719, 110116719, 110116719, 110116719, 102251239, 102251239, 102251239, 102251239, 102251239, 102251239, 102251239, 102251239, 102251239, 110116719, 106183979, 106183979, 110116719, 0]

def fV (q : Nat) : Nat := shahadaV.getD q 0
def fU (q : Nat) : Nat := shahadaU.getD q 0

theorem shahadaV_T : ∀ q : Fin 97, 10000 * T fV q.val ≤ 1057244 * fV q.val := by decide +kernel

theorem shahadaV_final : ∀ q : Fin 97,
    (if (machine false).final q.val then 1 else 0) ≤ 1 * fV q.val := by decide +kernel

theorem shahadaU_T : ∀ q : Fin 97, 1057242 * fU q.val ≤ 10000 * T fU q.val := by decide +kernel

theorem shahadaU_qaida : ∀ q : Fin 97, 1 * fU q.val ≤ (lawVec false 4).getD q.val 0 := by
  decide +kernel

theorem lawCount_aala (n : Nat) : 10000 ^ n * lawCount false n ≤ 1 * 1057244 ^ n * fV 0 := by
  rw [lawCount, lawVec_eq false n 0 (by decide)]
  exact hadd_aala false fV 1 1057244 10000 (fun q hq => shahadaV_T ⟨q, hq⟩)
    (fun q hq => shahadaV_final ⟨q, hq⟩) n 0 (by decide)

theorem lawCount_adna (n : Nat) :
    1 * 1057242 ^ n * fU 0 ≤ 10000 ^ n * lawCount false (4 + n) := by
  rw [lawCount, lawVec_eq false (4 + n) 0 (by decide)]
  exact hadd_adna false fU 4 1057242 10000 1 (fun q hq => shahadaU_T ⟨q, hq⟩)
    (fun q hq => (lawVec_eq false 4 q hq) ▸ shahadaU_qaida ⟨q, hq⟩) n 0 (by decide)

theorem adad_waqf :
    lawCount false 0 = 0 ∧ lawCount false 1 = 84 ∧ lawCount false 2 = 9436 ∧
    lawCount false 3 = 1052128 ∧ lawCount false 4 = 110116720 := by
  decide +kernel

theorem adad_wasl :
    lawCount true 0 = 0 ∧ lawCount true 1 = 84 ∧ lawCount true 2 = 9436 ∧
    lawCount true 3 = 987840 ∧ lawCount true 4 = 104650672 := by
  decide +kernel

/-- الوصلُ أضيقُ من الوقف ابتداءً من الطول الثالث، على الشاهد. -/
theorem wasl_adyaq_3 : lawCount true 3 < lawCount false 3 := by decide +kernel

end Jisr.Intrubiya
