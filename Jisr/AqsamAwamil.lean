/-- أقسامُ العامل من النقل إن لم يكن له قسمٌ من عائلات المالك (قسمان للفظ المشترك). -/
def qismOf2 (ism : String) (sinf : Nat) : Option (List Kind) :=
  match qismOf ism sinf with
  | some k => some [k]
  | none =>
    match (naql.filter fun n => n.amil == ism && n.sinf == sinf).map (·.qism) with
    | [] => none
    | ks => some ks

/-- المعجم بقطعتيه: (العامل، صنفه، أقسامه أو لا حكم). -/
def mujam2 : List (String × Nat × Option (List Kind)) :=
  Awamil.table.map fun r => (r.1, r.2.1, qismOf2 r.1 r.2.1)

/-- **النقول صحيحةُ الإحالة إلى الجدول:** كلُّ نقلٍ يسمّي صفًّا في جدول العوامل بصنفه، ولا نقلَ لما له قسمٌ من عائلات المالك،
ولا نقلان لصفٍّ واحد بقسمٍ واحد؛ 56 نقلًا لـ53 صفًّا، منها 12 بالاستدلال. -/
theorem naql_fi_jadwal :
    naql.all (fun n => Awamil.table.any fun r => r.1 == n.amil && r.2.1 == n.sinf) = true ∧
    naql.all (fun n => (qismOf n.amil n.sinf).isNone) = true ∧
    (naql.map fun n => (n.amil, n.sinf, n.qism)).Nodup ∧
    (naql.map fun n => (n.amil, n.sinf)).eraseDups.length = 53 ∧ naql.length = 56 ∧
    (naql.filter (·.istidlal)).length = 12 := by decide

/-- **98 من المئة لها قسم:** 45 من عائلات المالك و53 بالنقل — بقسمٍ واحد 95 (حروف 50، أفعال 27، أسماء 18) وبقسمين 3
(خلا، عدا، حاشا)؛ وبلا حكم 2. والنقول من الجنى الداني 23، والمغني 21، والألفية 8، والكتاب 4. -/
theorem mujam_98 :
    (mujam2.filter fun r => r.2.2.isSome).length = 98 ∧
    (mujam2.filter fun r => r.2.2 == some [.harf]).length = 50 ∧
    (mujam2.filter fun r => r.2.2 == some [.fil]).length = 27 ∧
    (mujam2.filter fun r => r.2.2 == some [.ism]).length = 18 ∧
    (mujam2.filter fun r => (r.2.2.map (·.length)) == some 2).length = 3 ∧
    ([Mudaa.janadani, .mughni, .alfiyya, .sibawayhi].map fun m => (naql.filter (·.mudaa == m)).length) = [23, 21, 8, 4] := by
  decide +kernel

/-- **ما بقي بلا حكم اثنان بأسمائهما:** شرع، بدأ. -/
theorem bila_hukm_2 :
    (mujam2.filter fun r => r.2.2.isNone).map (·.1) = ["شرع", "بدأ"] := by decide

/-- شواهد النقل: «مَن» اسمٌ في الصنفين (الكتاب؛ والاستفهام استدلالًا)، «خلا» حرفٌ وفعل، «صار» فعلٌ (الكتاب)، «هل» حرف،
«إذا» و«أنّى» اسمان بالظرفية، «شرع» لا حكم؛ والقطعةُ الأولى باقيةٌ بعينها («كان» فعل). -/
theorem shawahid2 :
    qismOf2 "مَن" 10 = some [.ism] ∧ qismOf2 "مَن" 12 = some [.ism] ∧ qismOf2 "خلا" 7 = some [.fil, .harf] ∧
    qismOf2 "صار" 1 = some [.fil] ∧ qismOf2 "هل" 12 = some [.harf] ∧ qismOf2 "إذا" 11 = some [.ism] ∧
    qismOf2 "أنى" 10 = some [.ism] ∧ qismOf2 "شرع" 6 = none ∧ qismOf2 "كان" 1 = some [.fil] := by decide

end AqsamAwamil
end Jisr
