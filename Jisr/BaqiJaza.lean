  ("hukmBayn", 9462, 9462, "فأما ما يرتفع بينهما فقولك إن تأتني تسألني أعطك وإن تأتني تمشي أمش معك"),
  ("hukmBayn", 9463, 9463, "وذلك لأنك أردت أن تقول إن تأتني سائلا يكن ذلك وإن تأتني ماشيا فعلت"),
  ("hukmBayn", 9466, 9466, "ولو رفع يغنها جاز وكان حسنا"),
  ("hukmBayn", 9471, 9471, "تلمم بدل من الفعل الأول"),
  ("hukmBayn", 9475, 9475, "فقوله يغدوا بدل من لا يحفلوا"),
  ("hukmBayn", 9476, 9477, "وسألته هل يكون إن تأتنا تسألنا نعطك فقال هذا يجوز على غير أن يكون مثل الأول"),
  ("hukmBayn", 9478, 9478, "ولكنه يجوز على الغلط والنسيان"),
  ("hukmBaad", 9481, 9482, "ومثل ذلك من الكلام إن تأتنا نحسن إليك نعطك ونحملك"),
  ("hukmBaad", 9483, 9483, "فإن قلت إن تأتني آتك أقل ذاك كان غير جائز لأن القول ليس بالإتيان"),
  ("hukmBayn", 9484, 9486, "وأما ما ينجزم بين المجزومين فقولك إن تأتني ثم تسألني أعطك وإن تأتني فتسألني أعطك وإن تأتني وتسألني أعطك"),
  ("hukmBayn", 9486, 9486, "وذلك لأن هذه الحروف يشركن الآخر فيما دخل فيه الأول وكذلك أو"),
  ("hukmBayn", 9487, 9487, "ولا يجوز في ذا الفعل الرفع"),
  ("hukmBayn", 9489, 9491, "وسألت الخليل عن قوله إن تأتني فتحدثني أحدثك وإن تأتني وتحدثني أحدثك فقال هذا يجوز والجزم الوجه"),
  ("hukmBayn", 9497, 9498, "فقال النصب في هذا جيد"),
  ("hukmJawab", 9499, 9500, "ولا يكون أبدا إذا قلت إن تأتني فأحدثك الفعل الآخر إلا رفعا"),
  ("hukmBaad", 9503, 9505, "وتقول إن تأتني آتك فأحدثك هذا الوجه وإن شئت ابتدأت وكذلك الواو وثم وإن شئت نصبت بالواو والفاء"),
  ("hukmBaad", 9505, 9506, "واعلم أن ثم لا ينصب بها كما ينصب بالواو والفاء"),
  ("hukmBayn", 9507, 9510, "واعلم أن ثم إذا أدخلته على الفعل الذي بين المجزومين لم يكن إلا جزما لأنه ليس مما ينصب وليس يحسن الابتداء لأن ما قبله لم ينقطع وكذلك الفاء والواو وأو إذا لم ترد بهن النصب"),
  ("hukmBaad", 9510, 9511, "فإذا انقضى الكلام ثم جئت بثم فإن شئت جزمت وإن شئت رفعت وكذلك الواو والفاء"),
  ("hukmBaad", 9515, 9516, "وتقول إن تأتني فهو خير لك وأكرمك وإن تأتني فأنا آتيك وأحسن إليك"),
  ("hukmBaad", 9517, 9517, "والرفع ههنا وجه الكلام وهو الجيد"),
  ("hukmBaad", 9519, 9520, "من يضلل الله فلا هادي له ويذرهم في طغيانهم يعمهون"),
  ("hukmJawab", 9528, 9529, "وأحسن ذلك أن تقول إن تأتني لا آتك كما أن أحسن الكلام أن تقول إن أتيتني لم آتك"),
  ("hukmJawab", 9530, 9531, "فإذا قلت إن تفعل فأحسن الكلام أن يكون الجواب أفعل لأنه نظيره من الفعل"),
  ("hukmJawab", 9531, 9532, "وإذ قال إن فعلت فأحسن الكلام أن تقول فعلت لأنه مثله"),
  ("hukmJawab", 9532, 9534, "فكما ضعف فعلت مع أفعل وأفعل مع فعلت قبح لم أفعل مع يفعل لأن لم أفعل نفي فعلت وقبح لا أفعل مع فعل"),
  ("hukmBaad", 9534, 9535, "واعلم أن النصب بالفاء والواو في قوله إن تأتني آتك وأعطيك ضعيف"),
  ("hukmBaad", 9540, 9540, "قال الأعشى فيما جاز من النصب"),
  ("hukmTalab", 9545, 9545, "إذا كان جوابا لأمر أو نهي أو استفهام أو تمن أو عرض"),
  ("hukmTalab", 9546, 9546, "فقولك ائتني آتك"),
  ("hukmTalab", 9546, 9546, "فقولك لا تفعل يكن خيرا لك"),
  ("hukmTalab", 9547, 9547, "فقولك ألا تأتيني أحدثك وأين تكون أزرك"),
  ("hukmTalab", 9548, 9548, "فقولك ألا ماء أشربه وليته عندنا يحدثنا"),
  ("hukmTalab", 9549, 9549, "فقولك ألا تنزل تصب خيرا"),
  ("hukmTalab", 9551, 9552, "وزعم الخليل أن هذه الأوائل كلها فيها معنى إن فلذلك انجزم الجواب"),
  ("hukmTalab", 9560, 9560, "أتيتنا أمس نعطك اليوم أي إن كنت أتيتنا أمس"),
  ("hukmTalab", 9561, 9562, "فإن كنت تريد أن تقرره بأنه قد فعل فإن الجزاء لا يكون لأن الجزاء إنما يكون في غير الواجب"),
  ("hukmTalab", 9567, 9568, "وقد سمعنا من العرب من يشمه الرفع كأنه يقول متى أنام غير مؤرق"),
  ("hukmTalab", 9568, 9569, "وتقول ائتني آتك فتجزم على ما وصفنا وإن شئت رفعت على أن لا تجعله معلقا بالأول ولكنك تبتدئه"),
  ("hukmTalab", 9578, 9578, "وتقول لا تدن منه يكن خيرا لك"),
  ("hukmTalab", 9578, 9579, "فإن قلت لا تدن من الأسديا كلك فهو قبيح إن جزمت وليس وجه كلام الناس"),
  ("hukmTalab", 9580, 9580, "فإن رفعت فالكلام حسن كأنك قلت لا تدن منه فإنه يأكلك"),
  ("hukmTalab", 9580, 9581, "وإن أدخلت الفاء فهو حسن وذلك قولك لا تدن منه فيأكلك"),
  ("hukmTalab", 9585, 9586, "وتقول ذره يقل ذاك وذره يقول ذاك فالرفع من وجهين فأحدهما الابتداء والآخر على قولك ذره قائلا ذاك"),
  ("hukmTalab", 9589, 9590, "ائتني تمشي أي ائتني ماشيا وإن شاء جزمه على أنه إن أتاه مشى فيما يستقبل وإن شاء رفعه على الابتداء"),
  ("hukmTalab", 9592, 9594, "وتقول قم يدعوك لأنك لم ترد أن تجعل دعاء بعد قيامه ويكون القيام سببا له ولكنك أردت قم إنه يدعوك وإن أردت ذلك المعنى جزمت"),
  ("hukmTalab", 9598, 9599, "ولو قلت مره يحفرها على الابتداء كان جيدا وقد جاء رفعه على شىء هو قليل في الكلام على مره أن يحفرها"),
  ("hukmTalab", 9601, 9601, "فالفعل كأنه في موضع اسم منصوب"),
  ("hukmTalab", 9602, 9602, "وقد جاء في الشعر قال طرفة بن العبد"),
  ("hukmTalab", 9610, 9610, "تقول حسبك ينم الناس"),
  ("hukmTalab", 9611, 9612, "لأن فيه معنى ليتق الله امرؤ وليفعل خيرا وكذلك ما أشبه هذا"),
  ("hukmTalab", 9613, 9613, "فأصدق وأكن من الصالحين"),
  ("hukmTalab", 9619, 9620, "فهذا على النهي كما قال لا تمددها فتشققها"),
  ("hukmTalab", 9622, 9623, "فقال الجزاء هاهنا خطأ لا يكون الجزاء أبدا حتى يكون الكلام الأول غير واجب إلا أن يضطر شاعر"),
  ("amma", 9624, 9624, "وسألته عن قوله أما أنت منطلقا انطلق معك فرفع"),
  ("amma", 9625, 9625, "وذلك لأنه لا يجازي بأن"),
  ("hukmShart", 9626, 9627, "وسألته عن قوله ما تدوم لي أدوم لك فقال ليس في هذا جزاء من قبل أن الفعل صلة لما"),
  ("kullama", 9628, 9629, "ويدلك على أن الجزاء لا يكون هاهنا أنك لا تستطيع أن تستفهم بما تدوم"),
  ("kullama", 9629, 9630, "ومثل ذلك كلما تأتيني آتيك فالإتيان صلة لما"),
  ("kullama", 9631, 9632, "ولا يستفهم بكلما كما لا يستفهم بما تدوم"),
  ("alladhi", 9632, 9632, "وسألته عن قوله الذي يأتيني فله درهمان"),
  ("alladhi", 9639, 9639, "فهذا جزاء وإن لم يجزم لأنه صلة"),
  ("alladhi", 9643, 9643, "قل إن الموت الذي تفرون منه فإنه ملاقيكم"),
  ("kull", 9639, 9640, "ومثل ذلك قولهم كل رجل يأتينا فله درهمان")]

