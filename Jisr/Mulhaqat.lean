/-! ## الحالات: استنفادٌ على الأدوار -/

/-- **حالاتُ اثني عشر دورًا بالنصّ لكلّ إطارٍ وملحق:** المفاعيلُ (المطلق، فيه) والحالُ نصبٌ دائمًا (L267)، والمفعولُ له نصبٌ أو
جرٌّ بالحرف، والمضافُ إليه جرٌّ دائمًا، والنائبُ محلُّه رفع، والتوابعُ الأربعة (التوكيد، البيان، النسق، البدل) حالةُ المتبوع،
والنعتُ كذلك إلّا المقطوع، والعاملُ الاسميّ لا حالةَ له من دوره. (والخمسةُ الباقية — المشغولُ عنه، المتنازَع، معه، التمييز،
المعدود — حالاتُها بالسياق في الشواهد.) -/
theorem halat_adwar (u : Itar) (m : Mulhaq) (h : Option Nat) :
    (m.dawr = .mutlaq ∨ m.dawr = .fihi ∨ m.dawr = .hal → halatMulhaq u m h = [0]) ∧
    (m.dawr = .lahu → halatMulhaq u m h = [0] ∨ halatMulhaq u m h = [2]) ∧
    (m.dawr = .mudafIlayhi → halatMulhaq u m h = [2]) ∧
    (m.dawr = .naib → halatMulhaq u m h = [1]) ∧
    (m.dawr = .tawkid ∨ m.dawr = .atfBayan ∨ m.dawr = .atfNasaq ∨ m.dawr = .badal → halatMulhaq u m h = h.toList) ∧
    (m.dawr = .nat → m.far = 0 → halatMulhaq u m h = h.toList) ∧
    (m.dawr = .amilIsmi → halatMulhaq u m h = []) := by
  refine ⟨fun hd => ?_, fun hd => ?_, fun hd => ?_, fun hd => ?_, fun hd => ?_, fun hd hf => ?_, fun hd => ?_⟩
  · rcases hd with hd | hd | hd <;> simp [halatMulhaq, hd]
  · simp only [halatMulhaq, hd, lahuHala]; split <;> simp
  · simp [halatMulhaq, hd]
  · simp [halatMulhaq, hd, naibMahall]
  · rcases hd with hd | hd | hd | hd <;> simp [halatMulhaq, hd]
  · simp [halatMulhaq, hd, hf]
  · simp [halatMulhaq, hd]

/-- شاهدٌ لكلّ دورٍ من السبعة عشر (من الشواهد أعلاه). -/
def shawahidKull : List Itar :=
  [{ ud := duriba, ml := [{ dawr := .naib, marsa := 1, t := noun 1 0 0 }] }, ishtZ 0 darabtuhu,
   { ud := darabaMudmar, thani := some darabtu, ml := [{ dawr := .mutanaza, marsa := 1, naw := 2, q := 4, t := noun 1 0 0 }] },
   { ud := darabtu, ml := [{ dawr := .mutlaq, marsa := 0, t := noun 0 0 0 }] },
   { ud := qumtu, ml := [{ dawr := .lahu, marsa := 0, naw := 4, t := noun 0 0 0 }] },
   { ud := qumtu, ml := [{ dawr := .fihi, marsa := 0, t := noun 1 0 0 }] },
   { ud := qumtu, ml := [{ dawr := .maahu, marsa := 1, t := noun 1 0 0 }] },
   { ud := darabtu, ml := [{ dawr := .hal, marsa := 2, t := noun 0 0 0 }] },
   { ud := bikam, ml := [{ dawr := .tamyiz, marsa := 1, naw := 2, t := noun 0 0 0 }] },
   { ud := darabaZayd, ml := [{ dawr := .mudafIlayhi, marsa := 1, t := noun 1 0 0 }] },
   { ud := zaydQaim, ml := [{ dawr := .amilIsmi, marsa := 1, naw := 1, far := fVS }] },
   { ud := jaaRajul, ml := [{ dawr := .nat, marsa := 1, t := noun 0 0 0 }] },
   { ud := darabaZayd, ml := [{ dawr := .tawkid, marsa := 1, naw := 1, t := noun 1 0 0 }] },
   { ud := darabaZayd, ml := [{ dawr := .atfBayan, marsa := 1, t := noun 1 0 0 }] },
   { ud := darabtu, ml := [{ dawr := .atfNasaq, marsa := 2, t := noun 1 0 0 }] },
   { ud := darabaZayd, ml := [{ dawr := .badal, marsa := 1, t := noun 1 0 0 }] },
   { ud := jaaSab, ml := [{ dawr := .madud, marsa := 1, q := 7, t := noun 0 1 2 }] }]

/-- **لا جزمَ على ملحقٍ اسميّ:** في شواهد الأدوار السبعة عشر كلِّها (مرخَّصةً) حالاتُ الملحقات من {رفع، نصب، جرّ} — انغلاقٌ
كانغلاق معادلات المالك (`Awamil.eqs_closed`)؛ والشواهدُ تستغرق الأدوار السبعة عشر. -/
theorem la_jazm :
    shawahidKull.all (fun u => itarOK u && (halatAt u 10 (nBase u)).all (· ≤ 2)) = true ∧
    (shawahidKull.flatMap fun u => u.ml.map (·.dawr)) = Dawr.kull := by decide +kernel

/-! ## التغطية: السبعة عشر المنتظرة كلُّها لها دورٌ هنا -/

/-- الدورُ الجديد لكلّ أسلوبٍ من المنتظرة في `Ikhbar.istinfad` (والمغطّى بأطر المالك لا دورَ جديدًا له). -/
def dawrOf : Ikhbar.Uslub → Option Dawr
  | .naib => some .naib | .ishtighal => some .mashghul | .tanazu => some .mutanaza
  | .mafulMutlaq => some .mutlaq | .mafulLahu => some .lahu | .mafulFihi => some .fihi | .mafulMaahu => some .maahu
  | .hal => some .hal | .tamyiz => some .tamyiz | .idafa => some .mudafIlayhi | .amal => some .amilIsmi
  | .nat => some .nat | .tawkid => some .tawkid | .atfBayan => some .atfBayan | .atfNasaq => some .atfNasaq
  | .badal => some .badal | .adad => some .madud
  | _ => none

/-- **التغطية كاملة:** الأساليب السبعة والعشرون كلُّها: عشرةٌ بأطر المالك (`Ikhbar.mughatta`) وسبعةَ عشرَ بأدوار هذه الطبقة —
واحدٌ لواحد (الأدوار السبعة عشر بعينها بلا تكرار)، ولا أسلوبَ بلا إطار. -/
theorem taghtiya_kamila :
    Ikhbar.kull.all (fun u => Ikhbar.mughatta u || (dawrOf u).isSome) = true ∧
    (Ikhbar.kull.filter fun u => !Ikhbar.mughatta u).filterMap dawrOf = Dawr.kull ∧
    (Ikhbar.kull.filter Ikhbar.mughatta).all (fun u => (dawrOf u).isNone) = true := by decide

/-! ## الرقم: كلُّ ملحقٍ ومكوّناته قيمةٌ في n -/

def mulhaqCode (m : Mulhaq) : Nat :=
  pair m.dawr.code (pair m.marsa (pair m.naw (pair (attrCode m.t) (pair m.q (pair (bCode m.qabl) m.far)))))

theorem mulhaqCode_inj (m k : Mulhaq) (h : mulhaqCode m = mulhaqCode k) : m = k := by
  obtain ⟨d, a, n, t, q, b, f⟩ := m
  obtain ⟨d', a', n', t', q', b', f'⟩ := k
  unfold mulhaqCode at h
  obtain ⟨h1, h⟩ := pair_injective h
  obtain ⟨h2, h⟩ := pair_injective h
  obtain ⟨h3, h⟩ := pair_injective h
  obtain ⟨h4, h⟩ := pair_injective h
  obtain ⟨h5, h⟩ := pair_injective h
  obtain ⟨h6, h7⟩ := pair_injective h
  simp only at h1 h2 h3 h4 h5 h6 h7
  rw [Dawr.code_inj _ _ h1, h2, h3, attrCode_inj _ _ h4, h5, bCode_inj _ _ h6, h7]

def itarEnc (u : Itar) : Nat := pair (udEnc u.ud) (pair (optCode u.thani) (encS (u.ml.map mulhaqCode)))

/-- **كلُّ مكوّنٍ في الإطار الممدود قيمةٌ في n:** إطاران ممدودان مرخَّصان برقمٍ واحد — إطارُهما الموحَّد واحد، وإطارُهما الثاني
واحد، وملحقاتُهما كلُّها واحدة بأدوارها ومراسيها وأنواعها وسماتها وقيمها وتقديمها وأطرها الفرعية. -/
theorem itar_value (u v : Itar) (hu : itarOK u = true) (hv : itarOK v = true) (h : itarEnc u = itarEnc v) : u = v := by
  unfold itarOK at hu hv
  simp only [Bool.and_eq_true] at hu hv
  unfold itarEnc at h
  obtain ⟨h1, h⟩ := pair_injective h
  obtain ⟨h2, h3⟩ := pair_injective h
  have e1 := ud_value _ _ hu.1.1.1.1.1 hv.1.1.1.1.1 h1
  have e2 := opt_inj _ _ hu.1.1.1.1.2 hv.1.1.1.1.2 h2
  have e3 := map_inj mulhaqCode mulhaqCode_inj _ _ (encS_inj _ _ h3)
  cases u; cases v
  simp only at e1 e2 e3
  subst e1 e2 e3; rfl

end Mulhaqat
end Jisr
