    itarOK { ud := jaaSab, ml := [{ dawr := .madud, marsa := 1, q := 11, t := noun 0 0 0 }] } = true ∧
    itarOK { ud := jaaSab, ml := [{ dawr := .madud, marsa := 1, q := 11, t := noun 0 0 2 }] } = false ∧
    itarOK { ud := jaaSab, ml := [{ dawr := .madud, marsa := 1, q := 11, t := noun 0 1 0 }] } = false ∧
