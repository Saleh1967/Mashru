    itarOK { ud := raaytuAqdan, ml := [{ dawr := .madud, marsa := 2, q := 20, t := noun 0 1 0 }] } = true ∧
    itarOK { ud := darabaMudmar, ml := [{ dawr := .madud, marsa := 1, q := 7, t := noun 0 1 2 }] } = false ∧
    halatAt { ud := jaaSab, ml := [{ dawr := .madud, marsa := 1, q := 7, t := noun 0 1 2 }] } 10 2 = [2] ∧
    halatAt { ud := jaaSab, ml := [{ dawr := .madud, marsa := 1, q := 11, t := noun 0 0 0 }] } 10 2 = [0] ∧
    halatAt { ud := jaaSab, ml := [{ dawr := .madud, marsa := 1, q := 100, t := noun 0 0 0 }] } 10 2 = [2] ∧
    (List.range 21).map (fun q => (adadJins 0 q 0 1, adadJins 0 q 0 0)) =
      [(some false, some true), (some false, some true), (some false, some true), (some true, some false), (some true, some false),
