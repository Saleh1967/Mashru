    itarOK { ud := darabaMudmar, ml := [{ dawr := .badal, marsa := 1, naw := 0, t := noun 1 0 0 }] } = false ∧
    itarOK { ud := darabaZayd, ml := [{ dawr := .badal, marsa := 3, naw := 0, t := noun 1 0 0 },
                                      { dawr := .badal, marsa := 2, naw := 0, t := noun 1 0 0 }] } = false ∧
