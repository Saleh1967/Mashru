    (framesL.filter fun g => g.1 == 1 && g.2.1 == 0).length = 32 ∧
    (List.range 9).map (fun k => (framesL.filter fun g => farOK k g false).length) = [0, 22, 22, 32, 32, 32, 22, 2, 0] ∧
    (framesL.filter fun g => farOK 7 g true).length = 4 ∧
    tafdilMutabaqa 0 (3, 0, 0) (3, 1, 2) = true ∧ tafdilMutabaqa 0 (3, 1, 2) (3, 1, 2) = false ∧
    tafdilMutabaqa 2 (3, 1, 2) (3, 1, 2) = true ∧ tafdilMutabaqa 2 (3, 0, 0) (3, 1, 2) = false ∧
    tafdilMutabaqa 3 (3, 0, 0) (3, 1, 2) = true ∧ tafdilMutabaqa 3 (3, 1, 2) (3, 1, 2) = true ∧ tafdilMutabaqa 3 (3, 0, 2) (3, 1, 2) = false ∧
    sifaMamul 0 1 = [1] ∧ sifaMamul 1 1 = [1] ∧ sifaMamul 2 0 = [0] ∧ sifaMamul 2 1 = [] ∧ sifaMamul 3 1 = [0] ∧ sifaMamul 4 1 = [2] := by
  decide +kernel

/-- **١٢ النعت** (أمثلةٌ على القاعدة؛ و«رجلٌ قاعدٌ غلمانُه» من القطر L381): «جاءني رجلٌ قاعدٌ» مرخَّص، و«رجلٌ القاعدُ» لا (التعريف)، و«رجلٌ قاعدةٌ» لا (الجنس)، ولا يتقدّم، ولا يُنعت مقدَّر؛ والسببيُّ «رجلٌ
قاعدٌ غلمانُه» بعاملٍ اسميٍّ ملحقٍ بالنعت، ولا سببيَّ بلا عامل؛ والقطعُ رفعًا بتقدير «هو» لمعلوم الموصوف، ولا قطعَ لغيره؛
وحالةُ النعت حالةُ منعوته (رفعٌ للفاعل، نصبٌ للمفعول) إلّا المقطوع. -/
theorem nat_shawahid :
    itarOK { ud := jaaRajul, ml := [{ dawr := .nat, marsa := 1, t := noun 0 0 0 }] } = true ∧
    itarOK { ud := jaaRajul, ml := [{ dawr := .nat, marsa := 1, t := noun 1 0 0 }] } = false ∧
    itarOK { ud := jaaRajul, ml := [{ dawr := .nat, marsa := 1, t := noun 0 1 0 }] } = false ∧
    itarOK { ud := jaaRajul, ml := [{ dawr := .nat, marsa := 1, t := noun 0 0 0, qabl := true }] } = false ∧
    itarOK { ud := darabaMudmar, ml := [{ dawr := .nat, marsa := 1, t := noun 1 0 0 }] } = false ∧
    itarOK { ud := jaaRajul, ml := [{ dawr := .nat, marsa := 1, t := noun 0 0 0, q := 1 },
                                  { dawr := .amilIsmi, marsa := 2, naw := 3, t := (1, 0, (3, 0, 0), false), far := fVF }] } = true ∧
    itarOK { ud := jaaRajul, ml := [{ dawr := .nat, marsa := 1, t := noun 0 0 0, q := 1 }] } = false ∧
    itarOK { ud := jaaRajul, ml := [{ dawr := .nat, marsa := 1, t := noun 0 0 0, far := 1, naw := 6 }] } = true ∧
    itarOK { ud := jaaRajul, ml := [{ dawr := .nat, marsa := 1, t := noun 0 0 0, far := 1, naw := 0 }] } = false ∧
    halatAt { ud := jaaRajul, ml := [{ dawr := .nat, marsa := 1, t := noun 0 0 0 }] } 10 2 = [1] ∧
    halatAt { ud := darabtu, ml := [{ dawr := .nat, marsa := 2, t := noun 1 0 0 }] } 10 3 = [0] ∧
    halatAt { ud := jaaRajul, ml := [{ dawr := .nat, marsa := 1, t := noun 0 0 0, far := 2, naw := 6 }] } 10 2 = [0] := by decide +kernel

/-- **١٣ التوكيد** (أمثلةٌ على القاعدة): «جاء زيدٌ نفسُه» مرخَّص ولا يتبع نكرة؛ «القومُ أنفسُهم» (يُجمع مع غير المفرد) لا «نفسُهم»؛ «نفسُه عينُه» لا
«عينُه نفسُه»؛ «القومُ كلُّهم» ولا «الزيدان كلُّهما» بل «كلاهما»؛ واللفظيُّ بلفظه؛ ولا تتعاطف المؤكَّدات. -/
theorem tawkid_shawahid :
    itarOK { ud := darabaZayd, ml := [{ dawr := .tawkid, marsa := 1, naw := 1, t := noun 1 0 0 }] } = true ∧
    itarOK { ud := jaaRajul, ml := [{ dawr := .tawkid, marsa := 1, naw := 1, t := noun 1 0 0 }] } = false ∧
    itarOK { ud := { darabaZayd with ats := [past 0 0, noun 1 0 2] }, ml := [{ dawr := .tawkid, marsa := 1, naw := 1, t := noun 1 0 2 }] } = true ∧
    itarOK { ud := { darabaZayd with ats := [past 0 0, noun 1 0 2] }, ml := [{ dawr := .tawkid, marsa := 1, naw := 1, t := noun 1 0 0 }] } = false ∧
    itarOK { ud := darabaZayd, ml := [{ dawr := .tawkid, marsa := 1, naw := 1, t := noun 1 0 0 }, { dawr := .tawkid, marsa := 1, naw := 2, t := noun 1 0 0 }] } = true ∧
    itarOK { ud := darabaZayd, ml := [{ dawr := .tawkid, marsa := 1, naw := 2, t := noun 1 0 0 }, { dawr := .tawkid, marsa := 1, naw := 1, t := noun 1 0 0 }] } = false ∧
    itarOK { ud := { darabaZayd with ats := [past 0 0, noun 1 0 2] }, ml := [{ dawr := .tawkid, marsa := 1, naw := 3, q := 1, t := noun 1 0 2 }] } = true ∧
    itarOK { ud := { darabaZayd with ats := [past 0 0, noun 1 0 1] }, ml := [{ dawr := .tawkid, marsa := 1, naw := 3, q := 1, t := noun 1 0 1 }] } = false ∧
    itarOK { ud := { darabaZayd with ats := [past 0 0, noun 1 0 1] }, ml := [{ dawr := .tawkid, marsa := 1, naw := 4, q := 1, t := noun 1 0 1 }] } = true ∧
    itarOK { ud := darabaZayd, ml := [{ dawr := .tawkid, marsa := 1, naw := 0, t := noun 1 0 0 }] } = true ∧
    itarOK { ud := darabaZayd, ml := [{ dawr := .tawkid, marsa := 1, naw := 0, t := noun 0 0 0 }] } = false ∧
    itarOK { ud := darabaZayd, ml := [{ dawr := .tawkid, marsa := 1, naw := 1, t := noun 1 0 0 }, { dawr := .atfNasaq, marsa := 2, naw := 0, t := noun 1 0 0 }] } = false := by
  decide +kernel

/-- **١٤ عطف البيان:** «أقسم بالله أبو حفصٍ عمرُ» (موضِّح لمعرفة) و«هذا خاتمٌ حديدٌ» (مخصِّص لنكرة) مرخَّصان (ممثَّلان بإطارَي «ضربَ زيدٌ» و«جاءني رجلٌ»)؛ ولا بغير موافقةٍ في
التعريف، ولا مشتقًّا؛ ويُعرب بدلَ كلٍّ إن لم يمتنع الإحلال («أنا ابن التارك البكريّ بشرٍ»: يمتنع). -/
theorem atf_bayan_shawahid :
    itarOK { ud := darabaZayd, ml := [{ dawr := .atfBayan, marsa := 1, naw := 0, t := noun 1 0 0 }] } = true ∧
    itarOK { ud := jaaRajul, ml := [{ dawr := .atfBayan, marsa := 1, naw := 1, t := noun 0 0 0 }] } = true ∧
    itarOK { ud := darabaZayd, ml := [{ dawr := .atfBayan, marsa := 1, naw := 0, t := noun 0 0 0 }] } = false ∧
    itarOK { ud := darabaZayd, ml := [{ dawr := .atfBayan, marsa := 1, naw := 0, t := noun 1 0 0, q := 1 }] } = false ∧
    atfBayanBadal { dawr := .atfBayan, marsa := 1, q := 0 } = true ∧ atfBayanBadal { dawr := .atfBayan, marsa := 1, q := 2 } = false := by
  decide +kernel

/-- **١٥ عطف النسق** (أمثلةٌ على القاعدة): «قام زيدٌ وعمرٌو»؛ ولا «قمتُ وزيدٌ» عطفًا على المستتر بلا توكيد (قانونُ المعيّة:
النصبُ واجب)، و«قمتُ أنا وزيدٌ» يُعطف؛ و«أم» بعد الهمزة لا بدونها؛ و«لا» بعد إيجابٍ لا بعد نفي؛ و«لكن» بعد نفيٍ لا بعد إيجاب؛
ومعاني الحروف: «أو» بعد الطلب تخييرٌ أو إباحة وبعد الخبر شكٌّ أو تشكيك (اثنان بلا ترجيح)، و«بل» بعد النفي ردٌّ وبعد الإيجاب
صرف، و«حتّى» للغاية والتدريج؛ **والمعطوفُ يأخذ حالةَ متبوعه** — وهي معادلةُ المالك `links 8 = [(9, 10)]`: رفعًا بعد الفاعل،
ونصبًا بعد المفعول، ومتسلسلًا («زيدٌ وعمرٌو وبكرٌ»). -/
theorem atf_nasaq_shawahid :
    itarOK { ud := darabaZayd, ml := [{ dawr := .atfNasaq, marsa := 1, naw := 0, t := noun 1 0 0 }] } = true ∧
    itarOK { ud := qumtu, ml := [{ dawr := .atfNasaq, marsa := 1, naw := 0, t := noun 1 0 0 }] } = false ∧
    itarOK { ud := qumtu, ml := [{ dawr := .tawkid, marsa := 1, naw := 0, t := pron 1 2 0 }, { dawr := .atfNasaq, marsa := 1, naw := 0, t := noun 1 0 0 }] } = true ∧
    itarOK { ud := darabaZayd, ml := [{ dawr := .atfNasaq, marsa := 1, naw := 5, t := noun 1 0 0 }] } = false ∧
    itarOK { ud := { darabaZayd with pre := [3] }, ml := [{ dawr := .atfNasaq, marsa := 1, naw := 5, t := noun 1 0 0 }] } = true ∧
    itarOK { ud := { darabaZayd with pre := [1] }, ml := [{ dawr := .atfNasaq, marsa := 1, naw := 6, t := noun 1 0 0 }] } = false ∧
    itarOK { ud := darabaZayd, ml := [{ dawr := .atfNasaq, marsa := 1, naw := 6, t := noun 1 0 0 }] } = true ∧
    itarOK { ud := darabaZayd, ml := [{ dawr := .atfNasaq, marsa := 1, naw := 7, t := noun 1 0 0 }] } = false ∧
    itarOK { ud := { darabaZayd with pre := [1] }, ml := [{ dawr := .atfNasaq, marsa := 1, naw := 7, t := noun 1 0 0 }] } = true ∧
    atfMana 4 true false = [4, 5] ∧ atfMana 4 false false = [6, 7] ∧ atfMana 8 false true = [9] ∧ atfMana 8 false false = [10] ∧
    atfMana 3 false false = [3] ∧ SLGE.Awamil.links 8 = [(9, 10)] ∧
    halatAt { ud := darabaZayd, ml := [{ dawr := .atfNasaq, marsa := 1, naw := 0, t := noun 1 0 0 }] } 10 2 = [1] ∧
    halatAt { ud := darabtu, ml := [{ dawr := .atfNasaq, marsa := 2, naw := 0, t := noun 1 0 0 }] } 10 3 = [0] ∧
    halatAt { ud := darabaZayd, ml := [{ dawr := .atfNasaq, marsa := 1, naw := 0, t := noun 1 0 0 },
                                     { dawr := .atfNasaq, marsa := 2, naw := 0, t := noun 1 0 0 }] } 10 3 = [1] := by decide +kernel

/-- **١٦ البدل:** «جاء زيدٌ أخوك» (مثال) بدلُ كلّ، ولا يتقدّم، ولا يرسو ملحقٌ على نفسه ولا على لاحقٍ (`marasiSabiqa`)، ولا يُبدَل من مقدَّر؛ والإضرابُ والغلطُ والنسيان صورةٌ واحدة تفترق بالقصد — ثلاثةٌ معًا. -/
theorem badal_shawahid :
    itarOK { ud := darabaZayd, ml := [{ dawr := .badal, marsa := 1, naw := 0, t := noun 1 0 0 }] } = true ∧
    itarOK { ud := darabaZayd, ml := [{ dawr := .badal, marsa := 1, naw := 3, t := noun 1 0 0 }] } = true ∧
