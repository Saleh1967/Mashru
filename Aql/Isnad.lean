open Aql.Azmina Aql.Makan Aql.Mirsat

/-! ## ١. الأجزاء -/

/-- الذات (المسندُ إليه: اسمُ جنسٍ أو علم): رمزٌ، وإضمارٌ متّصلٌ اختياريّ يعود على ذاتٍ أخرى («أبوه»: «إضمار كالهاء في الأب» س657). -/
structure Dhat where
  ramz : Nat
  damir : Option Nat := none
deriving DecidableEq, Repr

/-- العَرَض (المسند): فعلٌ بزمنٍ على محور الآن (إزاحةٌ ووحدة) ومفعولٍ اختياريّ («ضربت أخاه»)، أو وصفٌ لا زمانَ بهيئته بفاعلٍ سببيٍّ اختياريّ
(«عاقلا أبوه» س654). -/
inductive Arad
  | fiil (ramz : Nat) (t : Int) (u : Wahda) (maful : Option Dhat)
  | wasf (ramz : Nat) (fail : Option Dhat)
deriving DecidableEq, Repr

/-- المستقرّ: موضعٌ نسبةً إلى هنا («فيها … مستقرا لزيد» س5320؛ «الأصل فى الظروف الموضع والمستقر» س4091). -/
structure Mustaqarr where
  mawdi : Izaha3
deriving DecidableEq, Repr

/-- الرتبتان (قول المالك): الحاكمُ المسند، والمحكومُ المسندُ إليه. -/
inductive Rutba | hakim | mahkum
deriving DecidableEq, Repr

/-- النواسخ «بمنزلة الابتداء» (س238–239): كان، ليت. -/
inductive Nasikh | kana | layta
deriving DecidableEq, Repr

/-! ## ٢. الجملة بأنماطها الثلاثة والمنسوخة، وأجزاؤها -/

/-- الجملة الإسنادية: صغرى (ذاتٌ وعَرَض)، كبرى (ذاتٌ وجملةٌ في موضع الخبر: «كان زيد أبوه منطلق فهو مبتدأ وهو في موضع خبره» س9930)،
ظرفية (ذاتٌ ومستقرّ: «فيها عبد الله»)، منسوخة (ناسخٌ على جملة). لا منشئَ من جزءٍ واحد — «لا يغنى واحد منهما عن الآخر» (س235) بالنوع. -/
inductive Jumla
  | sughra (ilayh : Dhat) (musnad : Arad)
  | kubra (ilayh : Dhat) (khabar : Jumla)
  | zarfiyya (ilayh : Dhat) (mustaqarr : Mustaqarr)
  | mansukha (n : Nasikh) (j : Jumla)
deriving DecidableEq, Repr

/-- الجزء: مسندٌ إليه، أو مسندٌ (عَرَضٌ أو جملةٌ في موضع الخبر أو مستقرّ). -/
inductive Juz | ilayh (d : Dhat) | arad (a : Arad) | khabar (j : Jumla) | mustaqarr (m : Mustaqarr)
deriving DecidableEq, Repr

def rutba : Juz → Rutba
  | .ilayh _ => .mahkum
  | _ => .hakim

/-- أجزاءُ الجملة: المسندُ إليه ثمّ المسند (الناسخُ عاملٌ لا جزء). -/
def ajza : Jumla → List Juz
  | .sughra d a => [.ilayh d, .arad a]
  | .kubra d j => [.ilayh d, .khabar j]
  | .zarfiyya d m => [.ilayh d, .mustaqarr m]
  | .mansukha _ j => ajza j

/-- **كلُّ جملةٍ جزآن** — تعريفيّة (استقراءٌ على البنية). -/
theorem ajza_ithnan (j : Jumla) : (ajza j).length = 2 := by
  induction j with
  | sughra d a => rfl
  | kubra d j ih => rfl
  | zarfiyya d m => rfl
  | mansukha n j ih => simpa only [ajza] using ih

/-- **المحكومُ ثمّ الحاكم** في كلّ جملة (قول المالك: الرتبتان) — تعريفيّة (استقراءٌ على البنية). -/
theorem hakim_mahkum (j : Jumla) : (ajza j).map rutba = [.mahkum, .hakim] := by
  induction j with
  | sughra d a => rfl
  | kubra d j ih => rfl
  | zarfiyya d m => rfl
  | mansukha n j ih => simpa only [ajza] using ih

/-! ## ٣. الرابط «من سببه» والاستغناءُ بالسكوت -/

/-- الذواتُ التي يعود عليها إضمارٌ في العَرَض (مفعولُ الفعل، فاعلُ الوصف). -/
def Arad.sabab : Arad → List Nat
  | .fiil _ _ _ m => (m.bind Dhat.damir).toList
  | .wasf _ f => (f.bind Dhat.damir).toList

/-- الذواتُ التي يعود عليها إضمارٌ في الجملة («من سببه»: ما فيه إضمارٌ له). -/
def sabab : Jumla → List Nat
  | .sughra d a => d.damir.toList ++ a.sabab
  | .kubra d j => d.damir.toList ++ sabab j
  | .zarfiyya d _ => d.damir.toList
  | .mansukha _ j => sabab j

/-- الوصفُ بفاعلٍ سببيّ: فاعلُه «ملتبسٌ» بالمسند إليه (إضمارٌ يعود عليه) وإلّا «لم يكن كلاما» (س654–655)؛ وما سواه كلام. -/
def sababWasf (d : Dhat) : Arad → Bool
  | .wasf _ (some f) => f.damir == some d.ramz
  | _ => true

/-- **الاستغناءُ بالسكوت** (الكلام): الصغرى بشرط الوصف؛ والكبرى إذا كان خبرُها كلامًا وكان المسندُ إليه من سببه؛ والظرفيةُ؛ والمنسوخةُ بجملتها. -/
def yastaghni : Jumla → Bool
  | .sughra d a => sababWasf d a
  | .kubra d j => yastaghni j && (sabab j).contains d.ramz
  | .zarfiyya _ _ => true
  | .mansukha _ j => yastaghni j

/-- **الصغرى كلامٌ** بوصفٍ بلا فاعلٍ أو بفعل («عبد الله أخوك»، «يذهب عبد الله») — تعريفيّة. -/
theorem sughra_kalam (d : Dhat) (k : Nat) :
    yastaghni (.sughra d (.wasf k none)) = true ∧ ∀ (t : Int) (u : Wahda) (m : Option Dhat), yastaghni (.sughra d (.fiil k t u m)) = true :=
  ⟨rfl, fun _ _ _ => rfl⟩

/-- **الوصفُ بفاعلٍ** كلامٌ إذا وفقط إذا عاد إضمارُ فاعله على المسند إليه («عاقلا أبوه» / «عاقلا عمرو» س654–655) — تعريفيّة. -/
theorem wasf_bi_fail (d f : Dhat) (k : Nat) : yastaghni (.sughra d (.wasf k (some f))) = true ↔ f.damir = some d.ramz := by
  simp [yastaghni, sababWasf]

/-- **الظرفيةُ كلامٌ** — تعريفيّة («فيها عبد الله حسن السكوت وكان كلاما مستقيما» س5316). -/
theorem zarfiyya_kalam (d : Dhat) (m : Mustaqarr) : yastaghni (.zarfiyya d m) = true := rfl

/-- **المنسوخةُ على جملتها** — تعريفيّة («بمنزلة الابتداء» س238). -/
theorem nasikh_yahfaz (n : Nasikh) (j : Jumla) : yastaghni (.mansukha n j) = yastaghni j := rfl

/-- **الكبرى كلامٌ إذا وفقط إذا** كان خبرُها كلامًا وكان المسندُ إليه من سببه — تعريفيّة (فكُّ تعريف). -/
theorem kubra_kalam (d : Dhat) (j : Jumla) :
    yastaghni (.kubra d j) = true ↔ yastaghni j = true ∧ (sabab j).contains d.ramz = true := by
  simp [yastaghni]

/-- **الكبرى بلا سببٍ ليست كلامًا**: إذا لم يعد على المسند إليه إضمارٌ في الخبر «لم يكن كلاما لأنه ليس من سببه» (س655) — تعريفيّة. -/
theorem kubra_bila_sabab_la_kalam (d : Dhat) (j : Jumla) (h : (sabab j).contains d.ramz = false) :
    yastaghni (.kubra d j) = false := by
  simp only [yastaghni, h, Bool.and_false]

/-- **خبرُ الكبرى كلامٌ** («أبوه منطلق فهو مبتدأ» س9930؛ المغني س8811: «الصغرى هي المبنية على المبتدأ كالجملة المخبر بها») — تعريفيّة. -/
theorem khabar_kalam (d : Dhat) (j : Jumla) (h : yastaghni (.kubra d j) = true) : yastaghni j = true :=
  ((kubra_kalam d j).1 h).1

/-! ## ٤. الجملة على المرساة: زمنُ العَرَض من الآن وموضعُها من هنا -/

/-- زمنُ العَرَض عند المرساة: الفعلُ بإزاحته عن الآن، والوصفُ لا زمانَ بهيئته. -/
def zamanArad (r : Mirsat) : Arad → Option Zaman3
  | .fiil _ t u _ => some (zamanInda r t u)
  | .wasf _ _ => none

/-- **الوصفُ لا زمانَ له بهيئته** — تعريفيّة. -/
theorem wasf_la_zaman (r : Mirsat) (k : Nat) (f : Option Dhat) : zamanArad r (.wasf k f) = none := rfl

/-- موضعُ الجملة عند المرساة: الصغرى في موضع هنا (قراءةُ «حيز الموضع الحالي»)، والكبرى حيث خبرُها، والظرفيةُ في مستقرّها. -/
def mawdiInda (r : Mirsat) : Jumla → Izaha3
  | .sughra _ _ => r.huna
  | .kubra _ j => mawdiInda r j
  | .zarfiyya _ m => m.mawdi
  | .mansukha _ j => mawdiInda r j

/-- **الصغرى في موضع هنا** — تعريفيّة (قراءةُ البنّاء لقول المالك «في حيز الموضع الحالي»). -/
theorem sughra_huna (r : Mirsat) (d : Dhat) (a : Arad) : mawdiInda r (.sughra d a) = r.huna := rfl

/-- نقلُ العَرَض في الزمن بـ k (الفعلُ وحده). -/
def Arad.naql (k : Int) : Arad → Arad
  | .fiil n t u m => .fiil n (t + k) u m
  | .wasf n f => .wasf n f

/-- **زمنُ العَرَض يثبت** بنقل المرساة والعَرَض معًا (هويّة انزياح من `Mirsat.thabat_naql_zaman`). -/
theorem thabat_naql_arad (r : Mirsat) (k : Int) (v : Izaha3) (a : Arad) :
    zamanArad (naql r k v) (a.naql k) = zamanArad r a := by
  cases a with
  | fiil n t u m => simp only [zamanArad, Arad.naql]; rw [thabat_naql_zaman]
  | wasf n f => rfl

/-- نقلُ الجملة في المكان بـ v (المستقرُّ وحده يُنقل؛ والصغرى تتبع هنا). -/
def Jumla.naql (v : Izaha3) : Jumla → Jumla
  | .sughra d a => .sughra d a
  | .kubra d j => .kubra d (j.naql v)
  | .zarfiyya d m => .zarfiyya d ⟨Makan.jam m.mawdi v⟩
  | .mansukha n j => .mansukha n (j.naql v)

/-- **موضعُ الجملة يثبت نسبةً إلى هنا** بنقل المرساة والجملة معًا: هويّةُ انزياح — محتواها في الظرفية (المستقرّ)، وفي الصغرى صفرٌ = صفر. -/
theorem thabat_naql_mawdi (r : Mirsat) (k : Int) (v : Izaha3) (j : Jumla) :
    nisba (naql r k v).huna (mawdiInda (naql r k v) (j.naql v)) = nisba r.huna (mawdiInda r j) := by
  induction j with
  | sughra d a => simp only [mawdiInda, Jumla.naql]; rw [nisba_marja_nafsih, nisba_marja_nafsih]
  | kubra d j ih => simpa only [mawdiInda, Jumla.naql] using ih
  | zarfiyya d m =>
      simp only [mawdiInda, Jumla.naql, naql]
      unfold nisba Makan.jam Makan.aks
      congr 1 <;> dsimp only <;> omega
  | mansukha n j ih => simpa only [mawdiInda, Jumla.naql] using ih

/-- جهةُ المستقرّ من هنا على محور. -/
def jihaMustaqarr (r : Mirsat) (m : Mustaqarr) (mh : Mihwar) : Option Jiha := jihaInda r m.mawdi mh

/-- **جهةُ المستقرّ حاصرة**: الموجبةُ أو السالبةُ أو لا جهة على المحور (من `Makan.jiha_hasira`). -/
theorem mustaqarr_jiha (r : Mirsat) (m : Mustaqarr) (mh : Mihwar) :
    jihaMustaqarr r m mh = some (mujab mh) ∨ jihaMustaqarr r m mh = some (salib mh) ∨ jihaMustaqarr r m mh = none := by
  unfold jihaMustaqarr jihaInda
  have h := jiha_hasira mh (nisba r.huna m.mawdi)
  by_cases h1 : 0 < (nisba r.huna m.mawdi).ala mh
  · exact Or.inl (h.1.1 h1)
  · by_cases h2 : (nisba r.huna m.mawdi).ala mh < 0
    · exact Or.inr (Or.inl (h.2.1.1 h2))
    · exact Or.inr (Or.inr (h.2.2.1 (by omega)))

/-! ## ٥. الشواهد مبنيّة -/

def abdullah : Dhat := ⟨1, none⟩
def zayd : Dhat := ⟨2, none⟩
def amr : Dhat := ⟨3, none⟩
/-- «أبوه» — الهاءُ تعود على زيد. -/
def abuhu : Dhat := ⟨4, some 2⟩
/-- «أخاه» — الهاءُ تعود على زيد. -/
def akhahu : Dhat := ⟨5, some 2⟩
/-- المتكلّمُ (تاء «ضربتُ»). -/
def mutakallim : Dhat := ⟨6, none⟩
def akhuka : Arad := .wasf 10 none
def yadhhabu : Arad := .fiil 11 0 .yawm none
def muntaliq : Arad := .wasf 12 none
/-- «عاقلا أبوه» / «عاقلا عمرو»: وصفٌ بفاعلٍ. -/
def aqilAbuhu : Arad := .wasf 13 (some abuhu)
def aqilAmr : Arad := .wasf 13 (some amr)
/-- «ضربتُ أخاه» / «ضربتُ عمرا»: فعلٌ ماضٍ بمفعول. -/
def darabtuAkhahu : Arad := .fiil 14 (-1) .yawm (some akhahu)
def darabtuAmr : Arad := .fiil 14 (-1) .yawm (some amr)

/-- الشواهد: «عبد الله أخوك» س236، «يذهب عبد الله» س236–237، «كان زيد أبوه منطلق» س9929–9930، «ما زيد عاقلا أبوه» س654 و«ما زيد عاقلا عمرو»
س655 (على بنيتهما الإسنادية إثباتًا — النفي غير مبنيّ)، «زيد ضربت أخاه» (قراءةُ مثال المالك على «أزيدا ضربت أخاه» س1124–1125) و«زيد ضربت
عمرا» (على قياس س1165–1166)، «فيها عبد الله» س5313، «ههنا عمرو» و«ثم زيد» س5731. -/
def shawahid (r : Mirsat) (thamma : Izaha3) : List (String × Jumla) :=
  [("عبد الله أخوك", .sughra abdullah akhuka),
   ("يذهب عبد الله", .sughra abdullah yadhhabu),
   ("كان زيد أبوه منطلق", .mansukha .kana (.kubra zayd (.sughra abuhu muntaliq))),
   ("ما زيد عاقلا أبوه", .sughra zayd aqilAbuhu),
   ("ما زيد عاقلا عمرو", .sughra zayd aqilAmr),
   ("زيد ضربت أخاه", .kubra zayd (.sughra mutakallim darabtuAkhahu)),
   ("زيد ضربت عمرا", .kubra zayd (.sughra mutakallim darabtuAmr)),
   ("فيها عبد الله", .zarfiyya abdullah ⟨⟨0, 0, 2⟩⟩),
   ("ههنا عمرو", .zarfiyya amr ⟨r.huna⟩),
   ("ثم زيد", .zarfiyya zayd ⟨thamma⟩)]

/-- **الشواهدُ**: ثمانٍ كلامٌ واثنتان «لم يكن كلاما» (الخامسة والسابعة: ليس من سببه). -/
theorem shawahid_kalam :
    (shawahid ⟨0, sifr⟩ ⟨0, 0, 5⟩).map (fun p => yastaghni p.2) = [true, true, true, true, false, true, false, true, true, true] := by
  decide

/-- **الإضمارُ يفرّق** في الزوجين الأدنيين: «عاقلا أبوه» كلامٌ و«عاقلا عمرو» لا (س654–655)، و«ضربت أخاه» كلامٌ و«ضربت عمرا» لا (س1165–1166) —
والفرقُ الهاءُ العائدة (`abuhu.damir`، `akhahu.damir`). -/
theorem sabab_yufarriq :
    yastaghni (.sughra zayd aqilAbuhu) = true ∧ yastaghni (.sughra zayd aqilAmr) = false ∧
    yastaghni (.kubra zayd (.sughra mutakallim darabtuAkhahu)) = true ∧ yastaghni (.kubra zayd (.sughra mutakallim darabtuAmr)) = false ∧
    abuhu.damir = some zayd.ramz ∧ akhahu.damir = some zayd.ramz ∧ amr.damir = none := by decide

/-- **«ههنا عمرو»**: المستقرُّ هنا نفسُها (تعيين: إزاحةٌ صفر) — لا جهةَ له على محورٍ وهو «هذا». -/
theorem hahuna_la_jiha (hadd : Nat) : (∀ mh, jihaMustaqarr ⟨0, sifr⟩ ⟨sifr⟩ mh = none) ∧ mubhamOf hadd ⟨0, sifr⟩ sifr = .hadha := by
  refine ⟨fun mh => ?_, huna_hadha hadd ⟨0, sifr⟩⟩
  exact huna_la_jiha ⟨0, sifr⟩ mh

/-- **«ثم زيد»**: التبعيدُ — ما جاوز الحدَّ «ذاك» (اللسان س222982: «ثم … للتبعيد بمنزلة هنا للتقريب»)؛ وجهتُه أمامًا في الشاهد تعيين. -/
theorem thamma_dhaka : mubhamOf 2 ⟨0, sifr⟩ ⟨0, 0, 5⟩ = .dhaka ∧ jihaMustaqarr ⟨0, sifr⟩ ⟨⟨0, 0, 5⟩⟩ .tuli = some .amam := by decide

end Isnad
end Aql
