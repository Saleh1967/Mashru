[
 {
  "id": "B01",
  "fia": "موجب",
  "mithal": "ما تقول أقول",
  "mithal_harfi": true,
  "dakhil": {
   "qabl": "لا_شيء",
   "adat": "ما",
   "shart": "مضارع",
   "fil": "فعل_الشرط",
   "rabit": "بلا",
   "sura": "مرفوع",
   "mana": "صلة"
  },
  "kharij": {
   "kalam": "مقبول",
   "shir": "غير_مسؤول"
  },
  "sanad": [
   {
    "satr": 9306,
    "nass": "فإذا جعلتها بمنزلة الذي قلت ما تقول أقول"
   }
  ],
  "taliq": "«قلت» حُمل على «تقول» في المفتاح؛ ما بمنزلة الذي والفعل صلة"
 },
 {
  "id": "B02",
  "fia": "حد",
  "mithal": "مهما تقول",
  "mithal_harfi": true,
  "dakhil": {
   "qabl": "لا_شيء",
   "adat": "مهما",
   "shart": "مضارع",
   "fil": "فعل_الشرط",
   "rabit": "بلا",
   "sura": "مرفوع",
   "mana": "صلة"
  },
  "kharij": {
   "kalam": "خطأ",
   "shir": "غير_مسؤول"
  },
  "sanad": [
   {
    "satr": 9320,
    "nass": "ألا ترى أنه لا تقول مهما"
   },
   {
    "satr": 9321,
    "nass": "ولا في الكتاب مهما تقول إذا أراد أن يجعل القول وصلا"
   }
  ],
  "taliq": "«لا تقول» حُمل على «لا يجوز»؛ مهما لا يكون الفعل صلة لها"
 },
 {
  "id": "B03",
  "fia": "عموم",
  "mithal": "أين تكون أكون",
  "mithal_harfi": false,
  "dakhil": {
   "qabl": "لا_شيء",
   "adat": "أين",
   "shart": "مضارع",
   "fil": "فعل_الشرط",
   "rabit": "بلا",
   "sura": "مرفوع",
   "mana": "صلة"
  },
  "kharij": {
   "kalam": "خطأ",
   "shir": "غير_مسؤول"
  },
  "sanad": [
   {
    "satr": 9318,
    "nass": "وأكون أين تكن"
   },
   {
    "satr": 9319,
    "nass": "وإنما كان من قبل أنهم لم يجعلوا هذه الحروف"
   },
   {
    "satr": 9322,
    "nass": "الحروف بمنزلة إن لا يكون الفعل صلة لها"
   }
  ],
  "taliq": "عموم «هذه الحروف» على أين صلةً، ولم يمثّل للصلة إلا بمهما"
 },
 {
  "id": "B04",
  "fia": "موجب",
  "mithal": "إنه من يأتنا نأته",
  "mithal_harfi": true,
  "dakhil": {
   "qabl": "ناسخ_مشغول",
   "adat": "من",
   "shart": "مضارع",
   "fil": "الجواب",
   "rabit": "بلا",
   "sura": "مجزوم",
   "mana": "جزاء"
  },
  "kharij": {
   "kalam": "مقبول",
   "shir": "غير_مسؤول"
  },
  "sanad": [
   {
    "satr": 9328,
    "nass": "فإن شغلت هذه"
   },
   {
    "satr": 9329,
    "nass": "الحروف بشيء جازيت | فمن ذلك قولك إنه من يأتنا نأته"
   }
  ],
  "taliq": "شغل إن بالهاء فيجازى"
 },
 {
  "id": "B05",
  "fia": "عموم",
  "mithal": "إنه أيهم يأتنا نأته",
  "mithal_harfi": false,
  "dakhil": {
   "qabl": "ناسخ_مشغول",
   "adat": "أي",
   "shart": "مضارع",
   "fil": "الجواب",
   "rabit": "بلا",
   "sura": "مجزوم",
   "mana": "جزاء"
  },
  "kharij": {
   "kalam": "مقبول",
   "shir": "غير_مسؤول"
  },
  "sanad": [
   {
    "satr": 9328,
    "nass": "دليل على أن الجزاء لا ينبغي له أن يكون هاهنا بمن وما وأي فإن شغلت هذه"
   },
   {
    "satr": 9329,
    "nass": "الحروف بشيء جازيت"
   }
  ],
  "taliq": "عموم «فإن شغلت هذه الحروف بشيء جازيت» على أي، والمثال بمن وحدها"
 },
 {
  "id": "B06",
  "fia": "غموض",
  "mithal": "كان من يأته يعطه",
  "mithal_harfi": true,
  "dakhil": {
   "qabl": "ناسخ",
   "adat": "من",
   "shart": "مضارع",
   "fil": "الجواب",
   "rabit": "بلا",
   "sura": "مجزوم",
   "mana": "جزاء"
  },
  "kharij": {
   "kalam": [
    "مقبول",
    "خطأ"
   ],
   "shir": "مقبول"
  },
  "sanad": [
   {
    "satr": 9331,
    "nass": "وتقول كان من يأته يعطه"
   },
   {
    "satr": 9331,
    "nass": "إذا أضمرت الاسم في كان أو في"
   },
   {
    "satr": 9332,
    "nass": "فإن لم تضمر فالكلام على ما وصفنا"
   },
   {
    "satr": 9333,
    "nass": "جاء في الشعر إن من يأتني آته"
   },
   {
    "satr": 9343,
    "nass": "لو قلت ليس من يأتك تعطه"
   },
   {
    "satr": 9344,
    "nass": "تريد لست لم يجز"
   }
  ],
  "taliq": "يفرّق إضمارُ اسمٍ غائب في الناسخ (يجوز) أو عدمُه أو نيّةُ المخاطب (لا يجوز)؛ والشعر بإن"
 },
 {
  "id": "B07",
  "fia": "حد",
  "mithal": "إن إن تأتنا نأتك",
  "mithal_harfi": true,
  "dakhil": {
   "qabl": "ناسخ",
   "adat": "إن",
   "shart": "مضارع",
   "fil": "الجواب",
   "rabit": "بلا",
   "sura": "مجزوم",
   "mana": "جزاء"
  },
  "kharij": {
   "kalam": "خطأ",
   "shir": "غير_مسؤول"
  },
  "sanad": [
   {
    "satr": 9327,
    "nass": "ألا ترى أنك لو جئت بإن ومتى تريد إن إن وإن متى كان محالا"
   },
   {
    "satr": 9358,
    "nass": "كما لم يجز أن تقول إن إن تأتنا نأتك"
   }
  ],
  "taliq": "إن الناسخة قبل إن الجزاء محال"
 },
 {
  "id": "B08",
  "fia": "حد",
  "mithal": "أتذكر إذ من يأتنا نأته",
  "mithal_harfi": true,
  "dakhil": {
   "qabl": "حرف_ابتداء",
   "adat": "من",
   "shart": "مضارع",
   "fil": "فعل_الشرط",
   "rabit": "بلا",
   "sura": "مجزوم",
   "mana": "جزاء"
  },
  "kharij": {
   "kalam": "قبيح",
   "shir": "مقبول"
  },
  "sanad": [
   {
    "satr": 9359,
    "nass": "فلما ضارع هذا الباب باب إن وكان كرهوا الجزاء فيه | وقد يجوز في الشعر أن"
   },
   {
    "satr": 9360,
    "nass": "يجازي بعد هذه الحروف فتقول أتذكر إذ من يأتنا نأته"
   }
  ],
  "taliq": "«كرهوا» قبيح في الكلام، ويجوز في الشعر"
 },
 {
  "id": "B09",
  "fia": "حد",
  "mithal": "أتذكر إذ إن تأتنا نأتك",
  "mithal_harfi": true,
  "dakhil": {
   "qabl": "حرف_ابتداء",
   "adat": "إن",
   "shart": "مضارع",
   "fil": "الجواب",
   "rabit": "بلا",
   "sura": "مجزوم",
   "mana": "جزاء"
  },
  "kharij": {
   "kalam": "قبيح",
   "shir": "مقبول"
  },
  "sanad": [
   {
    "satr": 9357,
    "nass": "ألا ترى أنه لا"
   },
   {
    "satr": 9358,
    "nass": "يحسن أن تقول أتذكر إذ إن تأتنا نأتك"
   },
   {
    "satr": 9366,
    "nass": "ولو اضطر شاعر فقال أتذكر إذ إن تأتنا نأتك جاز له"
   }
  ],
  "taliq": "«لا يحسن» قبيح، و«لو اضطر شاعر … جاز» للشعر"
 },
 {
  "id": "B10",
  "fia": "عموم",
  "mithal": "ما أيهم يأتنا نأته",
  "mithal_harfi": false,
  "dakhil": {
   "qabl": "حرف_ابتداء",
   "adat": "أي",
   "shart": "مضارع",
   "fil": "فعل_الشرط",
   "rabit": "بلا",
