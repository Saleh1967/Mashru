  },
  "kharij": {
   "kalam": "قبيح",
   "shir": "مقبول"
  },
  "sanad": [
   {
    "satr": 9357,
    "nass": "وإنما كرهوا الجزاء هاهنا لأنه ليس من مواضعه"
   },
   {
    "satr": 9359,
    "nass": "وقد يجوز في الشعر أن"
   },
   {
    "satr": 9360,
    "nass": "يجازي بعد هذه الحروف"
   }
  ],
  "taliq": "عموم «هذا الباب» و«هذه الحروف» على ما وأي، ولم يمثّل إلا بمن وإن"
 },
 {
  "id": "B11",
  "fia": "موجب",
  "mithal": "أتذكر إذ نحن من يأتنا نأته",
  "mithal_harfi": true,
  "dakhil": {
   "qabl": "حرف_ابتداء_مفصول",
   "adat": "من",
   "shart": "مضارع",
   "fil": "فعل_الشرط",
   "rabit": "بلا",
   "sura": "مجزوم",
   "mana": "جزاء"
  },
  "kharij": {
   "kalam": "مقبول",
   "shir": "غير_مسؤول"
  },
  "sanad": [
   {
    "satr": 9367,
    "nass": "وتقول أتذكر إذ نحن من يأتنا نأته فنحن فصلت بين إذ ومن"
   }
  ],
  "taliq": "الفصل بالاسم يعيد الجزاء"
 },
 {
  "id": "B12",
  "fia": "موجب",
  "mithal": "مررت به فإذا من يأته يعطه",
  "mithal_harfi": false,
  "dakhil": {
   "qabl": "إذا_مضمر_بعدها",
   "adat": "من",
   "shart": "مضارع",
   "fil": "فعل_الشرط",
   "rabit": "بلا",
   "sura": "مجزوم",
   "mana": "جزاء"
  },
  "kharij": {
   "kalam": "مقبول",
   "shir": "غير_مسؤول"
  },
  "sanad": [
   {
    "satr": 9368,
    "nass": "وإن شئت جزمت لأن"
   },
   {
    "satr": 9369,
    "nass": "الإضمار يحسن هاهنا"
   },
   {
    "satr": 9370,
    "nass": "فإذا أردت الإضمار فكأنك قلت فإذا هو من يأته يعطه"
   }
  ],
  "taliq": "على إضمار «هو» بعد إذا"
 },
 {
  "id": "B13",
  "fia": "حد",
  "mithal": "مررت به فإذا من يأته يعطه",
  "mithal_harfi": false,
  "dakhil": {
   "qabl": "إذا_فجائية",
   "adat": "من",
   "shart": "مضارع",
   "fil": "فعل_الشرط",
   "rabit": "بلا",
   "sura": "مجزوم",
   "mana": "جزاء"
  },
  "kharij": {
   "kalam": "خطأ",
   "shir": "غير_مسؤول"
  },
  "sanad": [
   {
    "satr": 9370,
    "nass": "فإذا لم"
   },
   {
    "satr": 9371,
    "nass": "تضمر وجعلت إذا هي لمن فهي بمنزلة إذ لا يجوز فيها الجزم"
   }
  ],
  "taliq": "بلا إضمار؛ النطاق لم يذكر الشعر لإذا"
 },
 {
  "id": "B14",
  "fia": "موجب",
  "mithal": "لا إن أتيناك أعطيتنا",
  "mithal_harfi": true,
  "dakhil": {
   "qabl": "لا",
   "adat": "إن",
   "shart": "ماض",
   "fil": "الجواب",
   "rabit": "بلا",
   "sura": "ماض",
   "mana": "جزاء"
  },
  "kharij": {
   "kalam": "مقبول",
   "shir": "غير_مسؤول"
  },
  "sanad": [
   {
    "satr": 9381,
    "nass": "بعد لا يقوي الجزاء فيما بعد لا وذلك قول الرجل لا إن أتيناك أعطيتنا"
   }
  ],
  "taliq": "«قول الرجل» حُمل على «تقول»؛ لا لغو لا تغيّر الجزاء"
 },
 {
  "id": "B15",
  "fia": "موجب",
  "mithal": "وأما إن كان من أصحاب اليمين",
  "mithal_harfi": true,
  "dakhil": {
   "qabl": "حرف_ابتداء",
   "adat": "إن",
   "shart": "ماض",
   "fil": "فعل_الشرط",
   "rabit": "بلا",
   "sura": "ماض",
   "mana": "جزاء"
  },
  "kharij": {
   "kalam": "مقبول",
   "shir": "غير_مسؤول"
  },
  "sanad": [
   {
    "satr": 9394,
    "nass": "وأما إن كان من أصحاب اليمين"
   },
   {
    "satr": 9395,
    "nass": "وحسنت إن كان"
   },
   {
    "satr": 9396,
    "nass": "لأنه لم يجزم بها كما حسنت في قوله أنت ظالم إن فعلت"
   }
  ],
  "taliq": "بعد أما يحسن الماضي لأنه لم يجزم بها، خلافًا للمضارع المجزوم بعد إذ"
 },
 {
  "id": "B16",
  "fia": "حد",
  "mithal": "متى تكون أكون",
  "mithal_harfi": false,
  "dakhil": {
   "qabl": "لا_شيء",
   "adat": "متى",
   "shart": "مضارع",
   "fil": "فعل_الشرط",
   "rabit": "بلا",
   "sura": "مرفوع",
   "mana": "صلة"
  },
  "kharij": {
   "kalam": "خطأ",
   "shir": "غير_مسؤول"
  },
  "sanad": [
   {
    "satr": 9389,
    "nass": "ولا يجوز في متى أن يكون الفعل وصلا لها كما جاز في من والذي"
   }
  ],
  "taliq": "متى لا تكون موصولة"
 },
 {
  "id": "B17",
  "fia": "موجب",
  "mithal": "على أي دابة أحمل أركبه",
  "mithal_harfi": true,
  "dakhil": {
   "qabl": "حرف_جر",
   "adat": "أي",
   "shart": "مضارع",
   "fil": "الجواب",
   "rabit": "بلا",
   "sura": "مجزوم",
   "mana": "جزاء"
  },
  "kharij": {
   "kalam": "مقبول",
   "shir": "غير_مسؤول"
  },
  "sanad": [
   {
    "satr": 9399,
    "nass": "وذلك قولك على أي دابة أحمل أركبه"
   },
   {
    "satr": 9400,
    "nass": "فحروف الجر لم تغيرها عن حال"
   }
  ],
  "taliq": "حرف الجر لا يغيّر الجزاء"
 },
 {
  "id": "B18",
  "fia": "غموض",
  "mithal": "بمن تمرر أمرر",
  "mithal_harfi": true,
  "dakhil": {
   "qabl": "حرف_جر",
   "adat": "من",
   "shart": "مضارع",
   "fil": "الجواب",
   "rabit": "بلا",
   "sura": "مجزوم",
   "mana": "جزاء"
  },
  "kharij": {
   "kalam": [
    "مقبول",
    "ضعيف"
   ],
   "shir": "مقبول"
  },
  "sanad": [
   {
    "satr": 9421,
    "nass": "وتقول بمن تمرر أمرر به"
   },
   {
    "satr": 9422,
    "nass": "فحد الكلام أن تثبت الباء في الآخر"
   },
   {
    "satr": 9424,
    "nass": "قلت بمن تمرر أمرر أو بمن تؤخذ أوخذ فهو أمثل وليس بحد الكلام"
   },
   {
    "satr": 9416,
    "nass": "إن لم يجد يوما على من يتكل"
   },
   {
    "satr": 9417,
    "nass": "يريد يتكل عليه ولكنه حذف"
   }
  ],
  "taliq": "يفرّق إثبات الباء في الجواب (حد الكلام) أو حذفها مع إرادة معناها (أمثل وليس بحد الكلام)"
 },
 {
  "id": "B19",
  "fia": "حد",
  "mithal": "أإن تأتني آتيك",
  "mithal_harfi": true,
  "dakhil": {
   "qabl": "همزة",
   "adat": "إن",
   "shart": "مضارع",
   "fil": "الجواب",
   "rabit": "بلا",
   "sura": "مرفوع",
   "mana": "غير_معلن"
  },
  "kharij": {
   "kalam": "قبيح",
   "shir": "غير_مسؤول"
  },
  "sanad": [
   {
    "satr": 9441,
    "nass": "يونس فيقول أإن تأتني آتيك وهذا قبيح يكره في الجزاء"
   }
  ],
  "taliq": "قول يونس يرفع الجواب، والنطاق يقبّحه"
 },
 {
  "id": "B20",
  "fia": "عموم",
  "mithal": "أمهما تصنع أصنع",
  "mithal_harfi": false,
  "dakhil": {
   "qabl": "همزة",
   "adat": "مهما",
   "shart": "مضارع",
   "fil": "الجواب",
   "rabit": "بلا",
   "sura": "مجزوم",
   "mana": "جزاء"
  },
  "kharij": {
   "kalam": "مقبول",
   "shir": "غير_مسؤول"
  },
  "sanad": [
   {
    "satr": 9430,
    "nass": "أدخلت الألف على كلام قد عمل بعضه في بعض فلم يغيره وإنما الألف بمنزلة"
   },
   {
    "satr": 9431,
    "nass": "الواو والفاء ولا ونحو ذلك لا تغير الكلام عن حاله"
   }
  ],
  "taliq": "عموم «الألف لا تغير الكلام» على مهما، والأمثلة بإن ومتى ومن"
 },
 {
  "id": "B21",
  "fia": "موجب",
  "mithal": "أنا والله إن تأتني لا آتك",
  "mithal_harfi": true,
  "dakhil": {
   "qabl": "مبتدأ_ثم_قسم",
   "adat": "إن",
   "shart": "مضارع",
   "fil": "الجواب",
   "rabit": "بلا",
   "sura": "منفي_بلا_مجزوم",
   "mana": "جزاء"
  },
  "kharij": {
   "kalam": "مقبول",
   "shir": "غير_مسؤول"
  },
  "sanad": [
