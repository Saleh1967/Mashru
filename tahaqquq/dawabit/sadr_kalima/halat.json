{"id":"S02","jumla":"وَلْيَتَّقِ اللَّهَ رَبَّهُ","tsadr":"عطف+لام_أمر","mutawaqqa":"لا_تنطبق"},
{"id":"S03","jumla":"فَلْيَنْظُرْ أَيُّهَا أَزْكَى طَعَامًا","tsadr":"عطف+لام_أمر","mutawaqqa":"لا_تنطبق"},
{"id":"S04","jumla":"وَلْيَطَّوَّفُوا بِالْبَيْتِ الْعَتِيقِ","tsadr":"عطف+لام_أمر","mutawaqqa":"لا_تنطبق"},
{"id":"S05","jumla":"فَلْيَسْتَجِيبُوا لِي","tsadr":"عطف+لام_أمر","mutawaqqa":"لا_تنطبق"},
{"id":"S06","jumla":"وَلْيُوفُوا نُذُورَهُمْ","tsadr":"عطف+لام_أمر","mutawaqqa":"لا_تنطبق"},
{"id":"S07","jumla":"لِيُنْفِقْ ذُو سَعَةٍ مِنْ سَعَتِهِ","tsadr":"لام_أمر","mutawaqqa":"لا_تنطبق"},
{"id":"S08","jumla":"لِيَقْضِ عَلَيْنَا رَبُّكَ","tsadr":"لام_أمر","mutawaqqa":"لا_تنطبق"},
{"id":"S09","jumla":"لِيَشْهَدْ عَذَابَهُمَا طَائِفَةٌ","tsadr":"لام_أمر","mutawaqqa":"لا_تنطبق"},
{"id":"S10","jumla":"فَلْيَمْدُدْ لَهُ الرَّحْمَنُ مَدًّا","tsadr":"عطف+لام_أمر","mutawaqqa":"لا_تنطبق"},
{"id":"S11","jumla":"وَلْنَحْمِلْ خَطَايَاكُمْ","tsadr":"عطف+لام_أمر","mutawaqqa":"لا_تنطبق"},
{"id":"S12","jumla":"فَلْيَكْفُرْ بِنِعْمَةِ اللَّهِ","tsadr":"عطف+لام_أمر","mutawaqqa":"لا_تنطبق"},
{"id":"S13","jumla":"وَأَشْهِدُوا إِذَا تَبَايَعْتُمْ","tsadr":"عطف+أمر_همزة_وصل","mutawaqqa":"لا_تنطبق"},
{"id":"S14","jumla":"وَاتَّقُوا اللَّهَ","tsadr":"عطف+أمر_همزة_وصل","mutawaqqa":"لا_تنطبق"},
{"id":"S15","jumla":"وَاسْتَغْفِرُوا رَبَّكُمْ","tsadr":"عطف+أمر_همزة_وصل","mutawaqqa":"لا_تنطبق"},
{"id":"S16","jumla":"فَاعْبُدُوا اللَّهَ رَبِّي وَرَبَّكُمْ","tsadr":"عطف+أمر_همزة_وصل","mutawaqqa":"لا_تنطبق"},
{"id":"S17","jumla":"وَاذْكُرُوا اللَّهَ كَثِيرًا","tsadr":"عطف+أمر_همزة_وصل","mutawaqqa":"لا_تنطبق"},
{"id":"S18","jumla":"وَاصْبِرُوا إِنَّ اللَّهَ مَعَ الصَّابِرِينَ","tsadr":"عطف+أمر_همزة_وصل","mutawaqqa":"لا_تنطبق"},
{"id":"S19","jumla":"اعْبُدُوا رَبَّكُمُ الَّذِي خَلَقَكُمْ","tsadr":"أمر_همزة_وصل","mutawaqqa":"لا_تنطبق"},
{"id":"S20","jumla":"اسْتَعِينُوا بِالصَّبْرِ وَالصَّلَاةِ","tsadr":"أمر_همزة_وصل","mutawaqqa":"لا_تنطبق"},
{"id":"S21","jumla":"ادْخُلُوا الْجَنَّةَ بِمَا كُنْتُمْ تَعْمَلُونَ","tsadr":"أمر_همزة_وصل","mutawaqqa":"لا_تنطبق"},
{"id":"S22","jumla":"كُلُوا وَاشْرَبُوا هَنِيئًا","tsadr":"واو_جماعة","mutawaqqa":"لا_تنطبق"},
{"id":"S23","jumla":"ضَرَبُوا الْأَرْضَ","tsadr":"واو_جماعة","mutawaqqa":"لا_تنطبق"},
{"id":"S24","jumla":"قَالُوا سُبْحَانَكَ","tsadr":"واو_جماعة","mutawaqqa":"لا_تنطبق"},
{"id":"S25","jumla":"آمَنُوا بِاللَّهِ وَرَسُولِهِ","tsadr":"واو_جماعة","mutawaqqa":"لا_تنطبق"},
{"id":"S26","jumla":"وَيُعَلِّمُكُمُ اللَّهُ","tsadr":"عطف+مضارع","mutawaqqa":"مرخص"},
{"id":"S27","jumla":"وَيَعْلَمُ اللَّهُ مَا تَفْعَلُونَ","tsadr":"عطف+مضارع","mutawaqqa":"مرخص"},
{"id":"S28","jumla":"فَيَغْفِرُ لِمَنْ يَشَاءُ","tsadr":"عطف+مضارع","mutawaqqa":"مرخص"},
{"id":"S29","jumla":"وَيُنَزِّلُ الْغَيْثَ","tsadr":"عطف+مضارع","mutawaqqa":"مرخص"},
{"id":"S30","jumla":"ذَهَبَ الْوَلَدُ","tsadr":"غيره","mutawaqqa":"مرخص"},
{"id":"S31","jumla":"فَاغْفِرْ لَنَا ذُنُوبَنَا","tsadr":"عطف+أمر_همزة_وصل","mutawaqqa":"لا_تنطبق"},
{"id":"S32","jumla":"وَلْيَعْفُوا وَلْيَصْفَحُوا","tsadr":"عطف+لام_أمر","mutawaqqa":"لا_تنطبق"},
{"id":"S33","jumla":"لِتُؤْمِنُوا بِاللَّهِ وَرَسُولِهِ","tsadr":"لام_أمر","mutawaqqa":"لا_تنطبق"},
{"id":"S34","jumla":"وَيَسْتَغْفِرُونَ لِلَّذِينَ آمَنُوا","tsadr":"عطف+مضارع","mutawaqqa":"مرخص"}
