   "taliq": "الصورةُ بعد قلب الواو ياءً وإدغامها، ولا واوَ فيها."},
  {"id": "B39", "fia": "عموم", "kalima": "طَوْيٌ", "mithal_harfi": false, "hukm": "ممنوع", "badil": "طَيٌّ", "zawj": "B45",
   "sanad": [{"masdar": "ألفية", "satr": 1238, "nass": "إن يسكن السابق من واو ويا"}, {"masdar": "ألفية", "satr": 1239, "nass": "فياء الواو اقلبن مدغما"}],
   "taliq": "مصدرُ طوى: واوٌ ساكنة سكونًا أصليًّا تليها ياء متّصلة."},
  {"id": "B40", "fia": "عموم", "kalima": "طَوِيلٌ", "mithal_harfi": false, "hukm": "غير_ممنوع", "badil": null, "zawj": null,
   "sanad": [{"masdar": "ألفية", "satr": 1238, "nass": "إن يسكن السابق من واو ويا"}],
   "taliq": "السابقُ منهما (الواو) متحرّك فلم يتحقّق الشرط؛ الكتاب س20281–20282 «صيود وطويل»."},
  {"id": "B41", "fia": "عموم", "kalima": "ضَيْوَنٌ", "mithal_harfi": false, "hukm": "ممنوع", "badil": "ضَيَّنٌ", "zawj": null,
   "sanad": [{"masdar": "ألفية", "satr": 1238, "nass": "إن يسكن السابق من واو ويا"}, {"masdar": "ألفية", "satr": 1239, "nass": "فياء الواو اقلبن مدغما"}, {"masdar": "ألفية", "satr": 1239, "nass": "وشذ معطى غير ما قد رسما"}],
   "taliq": "مسموعٌ شاذّ (الكتاب س20319 «ضيون وضياون») لم يسمّه النطاق ولم يصفه، فيُحمل على الحكم."},
  {"id": "B42", "fia": "عموم", "kalima": "بُويِعَ", "mithal_harfi": false, "hukm": "لا_حكم", "badil": null, "zawj": null,
   "sanad": [{"masdar": "ألفية", "satr": 1238, "nass": "واتصلا ومن عروض عزيا"}, {"masdar": "ألفية", "satr": 1222, "nass": "إبدال واو بعد ضم من ألف"}],
   "taliq": "واوٌ ساكنة بدلٌ من ألف (س1222) تليها ياء؛ ولا يبيّن «عزيا» (قرأتُه عُرِّيا) أيعمّ بدليّةَ الحرف أم السكونَ وحده؛ الكتاب س20292–20295 لا يُقلب."},
  {"id": "B43", "fia": "غموض", "kalima": "قَوْيَانٌ", "mithal_harfi": false, "hukm": ["ممنوع", "غير_ممنوع"], "badil": null, "zawj": null,
   "sanad": [{"masdar": "ألفية", "satr": 1238, "nass": "إن يسكن السابق من واو ويا"}, {"masdar": "ألفية", "satr": 1238, "nass": "واتصلا ومن عروض عزيا"}, {"masdar": "ألفية", "satr": 1239, "nass": "فياء الواو اقلبن مدغما"}],
   "taliq": "إن كان فَعْلانَ فالسكونُ أصليّ فيُقلب، وإن كان فَعِلانَ مخفَّفًا فالسكونُ عارض فلا يُقلب (الكتاب س20885–20888)؛ وقرأتُ «عزيا» عُرِّيا."},
  {"id": "B44", "fia": "خارج", "kalima": "غَزَوَانٌ", "mithal_harfi": false, "hukm": "غير_ممنوع", "badil": null, "zawj": "B27",
   "sanad": [],
   "taliq": "الواوُ والألفُ بعد فتحة، ولا يحكم النطاق في الواو بعد الفتحة؛ وحكمُها في الأسطر 1240–1242 خارجه."},
  {"id": "B45", "fia": "خارج", "kalima": "طَوْلٌ", "mithal_harfi": false, "hukm": "غير_ممنوع", "badil": null, "zawj": "B39",
   "sanad": [],
   "taliq": "واوٌ ساكنة بعد فتحة لا ياءَ معها ولا كسرةَ ولا ضمّة قبلها."},
  {"id": "B46", "fia": "خارج", "kalima": "يُرْضَوَانِ", "mithal_harfi": false, "hukm": "غير_ممنوع", "badil": null, "zawj": null,
   "sanad": [],
   "taliq": "واوٌ لامٌ بعد فتحة يقلبها السطر 1221 «يرضيان» وهو خارج النطاق، ولا موضعَ فيها من النطاق."},
  {"id": "B47", "fia": "خارج", "kalima": "بَيَعَ", "mithal_harfi": false, "hukm": "غير_ممنوع", "badil": null, "zawj": null,
   "sanad": [],
   "taliq": "ياءٌ متحرّكة بعد فتحة بلا واو؛ يمنعها السطر 1240 وهو خارج النطاق."},
  {"id": "B48", "fia": "خارج", "kalima": "قَاوِلٌ", "mithal_harfi": false, "hukm": "غير_ممنوع", "badil": null, "zawj": null,
   "sanad": [],
   "taliq": "واوٌ بعد ألف فاعل يهمزها السطر 1206 خارج النطاق؛ لا كسرةَ قبلها ولا ياءَ معها، والألفُ بعد فتحة."},
  {"id": "B49", "fia": "غموض", "kalima": "عُونٌ", "mithal_harfi": false, "hukm": ["ممنوع", "غير_ممنوع"], "badil": null, "zawj": null,
   "sanad": [{"masdar": "ألفية", "satr": 1224, "nass": "ويكسر المضموم في جمع كما"}, {"masdar": "ألفية", "satr": 1222, "nass": "ويا كموقن بذا لها اعترف"}],
   "taliq": "إن كان جمعًا لما عينُه ياء (جمعَ عيناء) فالنطاق يوجب كسر المضموم وبقاء الياء، وإن كانت الواو أصليّة (جمعَ عوان) فلا موضعَ للنطاق فيه."}
]
