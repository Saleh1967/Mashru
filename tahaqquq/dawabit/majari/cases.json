[
  {
    "id": "M01",
    "fia": "موجب",
    "mithal": "رأيت زيدا",
    "mithal_harfi": true,
    "dakhil": { "sinf": "اسم_متمكن", "lafz": "", "mawdi": "نصب" },
    "kharij": { "alama": ["فتحة"], "bina": false },
    "sanad": [
      { "satr": 119, "nass": "والجر والنصب والجزم لحروف الإعراب وحروف الإعراب للأسماء المتمكنة" },
      { "satr": 122, "nass": "والنصب في الأسماء رأيت زيدا" }
    ],
    "taliq": "النصب لحروف الإعراب في المتمكن، والنصب والفتح ضربٌ واحد في اللفظ"
  },
  {
    "id": "M02",
    "fia": "موجب",
    "mithal": "زيد",
    "mithal_harfi": true,
    "dakhil": { "sinf": "اسم_متمكن", "lafz": "", "mawdi": "رفع" },
    "kharij": { "alama": ["ضمة"], "bina": false },
    "sanad": [
      { "satr": 122, "nass": "والرفع هذا" },
      { "satr": 123, "nass": "زيد" }
    ],
    "taliq": "المثال «هذا زيد» يعبر سطرين"
  },
  {
    "id": "M03",
    "fia": "موجب",
    "mithal": "يفعل",
    "mithal_harfi": true,
    "dakhil": { "sinf": "مضارع", "lafz": "", "mawdi": "نصب" },
    "kharij": { "alama": ["فتحة"], "bina": false },
    "sanad": [
      { "satr": 119, "nass": "لحروف الإعراب وحروف الإعراب للأسماء المتمكنة" },
      { "satr": 120, "nass": "وللأفعال المضارعة" },
      { "satr": 124, "nass": "والنصب في المضارع من الأفعال لن" },
      { "satr": 125, "nass": "يفعل" }
    ],
    "taliq": "«لن يفعل» يعبر سطرين"
  },
  {
    "id": "M04",
    "fia": "موجب",
    "mithal": "سيفعل",
    "mithal_harfi": true,
    "dakhil": { "sinf": "مضارع", "lafz": "", "mawdi": "رفع" },
    "kharij": { "alama": ["ضمة"], "bina": false },
    "sanad": [
      { "satr": 125, "nass": "والرفع سيفعل" }
    ],
    "taliq": "المؤكَّد بالنون في «هل تفعلن» (س200) مبنيٌّ على الفتح، وحملتُه على غير هذا الصنف إذ لا يحمل الحقلُ النون"
  },
  {
    "id": "M05",
    "fia": "موجب",
    "mithal": "لم يفعل",
    "mithal_harfi": true,
    "dakhil": { "sinf": "مضارع", "lafz": "", "mawdi": "جزم" },
    "kharij": { "alama": ["سكون"], "bina": false },
    "sanad": [
      { "satr": 125, "nass": "والجزم لم يفعل" }
    ],
    "taliq": "الجزم والوقف ضربٌ واحد في اللفظ، والجزم هنا إعراب"
  },
  {
    "id": "M06",
    "fia": "موجب",
    "mithal": "هما الرجلان",
    "mithal_harfi": true,
    "dakhil": { "sinf": "مثنى", "lafz": "", "mawdi": "رفع" },
    "kharij": { "alama": ["ألف"], "bina": false },
    "sanad": [
      { "satr": 156, "nass": "وهو حرف الإعراب غير متحرك" },
      { "satr": 157, "nass": "يكون في الرفع ألفا" },
      { "satr": 163, "nass": "وذلك قولك هما الرجلان" }
    ],
    "taliq": "الزيادة الأولى حرف الإعراب، والنون عوضٌ لا علامة إعراب"
  },
  {
    "id": "M07",
    "fia": "موجب",
    "mithal": "رأيت الرجلين",
    "mithal_harfi": true,
    "dakhil": { "sinf": "مثنى", "lafz": "", "mawdi": "نصب" },
    "kharij": { "alama": ["ياء"], "bina": false },
    "sanad": [
      { "satr": 158, "nass": "ويكون في الجر ياء مفتوحا ما قبلها" },
      { "satr": 159, "nass": "ويكون في النصب كذلك ولم يجعلوا النصب" },
      { "satr": 160, "nass": "ألفا" },
      { "satr": 163, "nass": "ورأيت الرجلين" }
    ],
    "taliq": "«كذلك» هنا إحالةٌ على الياء قبلها في السطر نفسه، ونفى الألف في النصب"
  },
  {
    "id": "M08",
    "fia": "موجب",
    "mithal": "المسلمون",
    "mithal_harfi": true,
    "dakhil": { "sinf": "جمع_مذكر", "lafz": "", "mawdi": "رفع" },
    "kharij": { "alama": ["واو"], "bina": false },
    "sanad": [
      { "satr": 165, "nass": "وأنها حرف الإعراب" },
      { "satr": 166, "nass": "إلا أنها واو مضموم ما قبلها في الرفع" },
      { "satr": 168, "nass": "وذلك قولك المسلمون" }
    ],
    "taliq": "فتح النون في الجمع ليس علامةَ الإعراب"
  },
  {
    "id": "M09",
    "fia": "موجب",
    "mithal": "رأيت المسلمات",
    "mithal_harfi": false,
    "dakhil": { "sinf": "جمع_مؤنث", "lafz": "", "mawdi": "نصب" },
    "kharij": { "alama": ["كسرة"], "bina": false },
    "sanad": [
      { "satr": 169, "nass": "جعلوا تاء الجمع في الجر والنصب مكسورة" },
      { "satr": 170, "nass": "لأنهم جعلوا التاء التي هي حرف الإعراب" }
    ],
    "taliq": "«مكسورة» بلفظ الكسر لكنّ التاء حرف الإعراب فهو إعراب؛ المثال مركَّب على «رأيت المسلمين»"
  },
  {
    "id": "M10",
    "fia": "موجب",
    "mithal": "يفعلان",
    "mithal_harfi": true,
    "dakhil": { "sinf": "مضارع_اثنين", "lafz": "", "mawdi": "رفع" },
    "kharij": { "alama": ["ثبات_النون"], "bina": false },
    "sanad": [
      { "satr": 177, "nass": "فجعلوا إعرابه في الرفع ثبات النون" },
      { "satr": 184, "nass": "وذلك قولك هما" },
      { "satr": 185, "nass": "يفعلان" }
    ],
    "taliq": "الألف ليست حرف الإعراب (س173)، والإعراب ثبات النون"
  },
  {
    "id": "M11",
    "fia": "موجب",
    "mithal": "لم يفعلا",
    "mithal_harfi": true,
    "dakhil": { "sinf": "مضارع_اثنين", "lafz": "", "mawdi": "جزم" },
    "kharij": { "alama": ["حذف_النون"], "bina": false },
    "sanad": [
      { "satr": 181, "nass": "فأثبتوها في الرفع وحذفوها" },
      { "satr": 182, "nass": "في الجزم كما حذفوا الحركة في الواحد" },
      { "satr": 185, "nass": "يفعلان ولم يفعلا" }
    ],
    "taliq": "حذف النون في الجزم كحذف الحركة في الواحد"
  },
  {
    "id": "M12",
    "fia": "موجب",
    "mithal": "لم يرم",
    "mithal_harfi": true,
    "dakhil": { "sinf": "مضارع_ساكن_الآخر", "lafz": "", "mawdi": "جزم" },
    "kharij": { "alama": ["حذف_الآخر"], "bina": false },
    "sanad": [
      { "satr": 230, "nass": "وأعلم أن الآخر إذا كان يسكن في" },
      { "satr": 231, "nass": "الرفع حذف في الجزم" },
      { "satr": 232, "nass": "وذلك قولك لم يرم ولم يغز ولم يخش" }
    ],
    "taliq": "الحذف للجزم لئلا يكون بمنزلة الرفع، فهو ممّا يحدثه العامل"
  },
  {
    "id": "M13",
    "fia": "موجب",
    "mithal": "هو يرمي",
    "mithal_harfi": true,
    "dakhil": { "sinf": "مضارع_ساكن_الآخر", "lafz": "", "mawdi": "رفع" },
    "kharij": { "alama": ["سكون"], "bina": false },
    "sanad": [
      { "satr": 232, "nass": "وهو في الرفع" },
      { "satr": 233, "nass": "ساكن الآخر لتقول هو يرمي ويغزو ويخشى" }
    ],
    "taliq": "سكونٌ في الرفع يزول بالحذف في الجزم، فهو حال إعراب لا بناء؛ حُمل «ساكن» على السكون"
  },
  {
    "id": "M14",
    "fia": "موجب",
    "mithal": "لن يفعلن",
    "mithal_harfi": true,
    "dakhil": { "sinf": "مضارع_نسوة", "lafz": "", "mawdi": "نصب" },
    "kharij": { "alama": ["سكون"], "bina": true },
    "sanad": [
      { "satr": 193, "nass": "وأسكنت ما كان في" },
      { "satr": 194, "nass": "الواحد حرف الأعراب" },
      { "satr": 195, "nass": "وبنى على هذه العلامة" },
      { "satr": 197, "nass": "هن يفعلن ولن يفعلن" }
    ],
    "taliq": "العلامة سكونُ ما كان حرفَ الإعراب مبنيًّا على النون؛ وفتح النون (س198) حركةُ نون الجمع لا علامةُ الكلمة"
  },
  {
    "id": "M15",
    "fia": "موجب",
    "mithal": "أحمر",
    "mithal_harfi": true,
    "dakhil": { "sinf": "اسم_لا_ينصرف", "lafz": "", "mawdi": "جر" },
    "kharij": { "alama": ["فتحة"], "bina": false },
    "sanad": [
      { "satr": 208, "nass": "وذلك نحو أبيض وأسود وأحمر وأصفر" },
      { "satr": 209, "nass": "فيكون في موضع الجر مفتوحا" }
    ],
    "taliq": "«مفتوحا» بلفظ الفتح في موضع الجرّ، وهو ينجرّ إذا عُرِّف (س226–227) فليس بناءً لا يزول"
  },
  {
    "id": "M16",
    "fia": "موجب",
    "mithal": "قبل",
    "mithal_harfi": true,
    "dakhil": { "sinf": "غير_متمكن", "lafz": "قبل", "mawdi": "بلا_عامل" },
    "kharij": { "alama": ["ضمة"], "bina": true },
    "sanad": [
      { "satr": 139, "nass": "والصم نحو حيث وقبل وبعد" }
    ],
    "taliq": "«الصم» تصحيفُ «الضم» بقرينة ترتيب الفتح والكسر والضم والوقف في س135–140"
  },
  {
    "id": "M17",
    "fia": "موجب",
    "mithal": "كم",
    "mithal_harfi": true,
    "dakhil": { "sinf": "غير_متمكن", "lafz": "كم", "mawdi": "بلا_عامل" },
    "kharij": { "alama": ["سكون"], "bina": true },
    "sanad": [
      { "satr": 140, "nass": "والوقف نحو من وكم وقط وإذ" }
    ],
    "taliq": "الوقف في الأسماء غير المتمكنة"
  },
  {
    "id": "M18",
    "fia": "موجب",
    "mithal": "بزيد",
    "mithal_harfi": true,
    "dakhil": { "sinf": "غير_متمكن", "lafz": "ب", "mawdi": "بلا_عامل" },
    "kharij": { "alama": ["كسرة"], "bina": true },
    "sanad": [
      { "satr": 151, "nass": "والفتح في الحروف التي ليست إلا لمعنى وليست بأسماء ولا" },
      { "satr": 152, "nass": "والكسر فيها قولهم في باء الإضافة ولامها بزيد ولزيد" }
    ],
    "taliq": "باء الإضافة من الحروف التي جاءت لمعنى، مكسورةٌ بناءً"
  },
  {
    "id": "M19",
    "fia": "موجب",
    "mithal": "منذ",
    "mithal_harfi": true,
    "dakhil": { "sinf": "غير_متمكن", "lafz": "منذ", "mawdi": "بلا_عامل" },
    "kharij": { "alama": ["ضمة"], "bina": true },
    "sanad": [
      { "satr": 153, "nass": "والضم فيها منذ فيمن جر بها" }
    ],
    "taliq": "في الحروف، فيمن جرّ بها؛ ومن لم يجرّ بها لم يذكره الباب"
  },
  {
    "id": "M20",
    "fia": "موجب",
    "mithal": "اضرب",
    "mithal_harfi": true,
    "dakhil": { "sinf": "أمر", "lafz": "", "mawdi": "بلا_عامل" },
    "kharij": { "alama": ["سكون"], "bina": true },
    "sanad": [
      { "satr": 149, "nass": "الوقف قولهم اضرب في الأمر لم يحركوها" }
    ],
    "taliq": "«لم يحركوها» بناءٌ على الوقف"
  },
  {
    "id": "M21",
    "fia": "حد",
    "mithal": "زيد",
    "mithal_harfi": true,
    "dakhil": { "sinf": "اسم_متمكن", "lafz": "", "mawdi": "جزم" },
    "kharij": { "alama": "لا_يكون" },
    "sanad": [
      { "satr": 123, "nass": "وليس في الأسماء جزم لتمكنها" }
    ],
    "taliq": "«ليس في الأسماء جزم»"
  },
  {
    "id": "M22",
    "fia": "حد",
    "mithal": "يفعل",
    "mithal_harfi": true,
    "dakhil": { "sinf": "مضارع", "lafz": "", "mawdi": "جر" },
    "kharij": { "alama": "لا_يكون" },
    "sanad": [
      { "satr": 125, "nass": "وليس في الأفعال المضارعة جر" }
    ],
    "taliq": "«ليس في الأفعال المضارعة جر»"
  },
  {
    "id": "M23",
    "fia": "حد",
    "mithal": "الرجلان",
    "mithal_harfi": false,
    "dakhil": { "sinf": "مثنى", "lafz": "", "mawdi": "جزم" },
    "kharij": { "alama": "لا_يكون" },
    "sanad": [
      { "satr": 183, "nass": "نظير الجر في الأسماء والأسماء" },
      { "satr": 184, "nass": "ليس لها في الجزم نصيب" }
    ],
    "taliq": "النفي على الأسماء عامّة، والمثنى اسم"
  },
  {
    "id": "M24",
    "fia": "حد",
    "mithal": "ضرب",
    "mithal_harfi": false,
    "dakhil": { "sinf": "ماض", "lafz": "", "mawdi": "جر" },
    "kharij": { "alama": "لا_يكون" },
    "sanad": [
      { "satr": 184, "nass": "كما أنه ليس للفعل في الجر نصيب" },
      { "satr": 228, "nass": "ولا يكون ذلك في الأفعال" }
    ],
    "taliq": "النفي على الفعل والأفعال عامّة، والماضي فعل"
  },
  {
    "id": "M25",
    "fia": "حد",
    "mithal": "اضرب",
    "mithal_harfi": true,
    "dakhil": { "sinf": "أمر", "lafz": "", "mawdi": "جزم" },
    "kharij": { "alama": "لا_يكون" },
    "sanad": [
      { "satr": 149, "nass": "لأنها لا يوصف بها ولا تقع موقع" },
      { "satr": 150, "nass": "المضارعة فبعدت من المضارعة" }
    ],
    "taliq": "«لا تقع موقع المضارعة» حُمل على «ليس في…»؛ بخلاف فعل التي «وقعت موقعها في إن» (س144)"
  },
  {
    "id": "M26",
    "fia": "خارج",
    "mithal": "المسلمات",
    "mithal_harfi": false,
    "dakhil": { "sinf": "جمع_مؤنث", "lafz": "", "mawdi": "رفع" },
    "kharij": { "alama": "لا_حكم" },
    "sanad": [],
    "taliq": "ذكر الباب تاء الجمع في الجرّ والنصب وحدهما (س169) ولم يذكر رفعها"
  },
  {
    "id": "M27",
    "fia": "خارج",
    "mithal": "لن يرمي",
    "mithal_harfi": false,
    "dakhil": { "sinf": "مضارع_ساكن_الآخر", "lafz": "", "mawdi": "نصب" },
    "kharij": { "alama": "لا_حكم" },
    "sanad": [],
    "taliq": "ذكر الباب رفعه وجزمه وحدهما (س230–233) ولم يذكر نصبه"
  },
  {
    "id": "M28",
    "fia": "خارج",
    "mithal": "لن",
    "mithal_harfi": false,
    "dakhil": { "sinf": "غير_متمكن", "lafz": "لن", "mawdi": "بلا_عامل" },
    "kharij": { "alama": "لا_حكم" },
    "sanad": [],
    "taliq": "وردت عاملًا في «لن يفعل» (س124) ولم يسمِّ الباب حركةَ آخرها في الحروف"
  },
  {
    "id": "M29",
    "fia": "خارج",
    "mithal": "ابدأ بهذا أول",
    "mithal_harfi": false,
    "dakhil": { "sinf": "غير_متمكن", "lafz": "أول", "mawdi": "بلا_عامل" },
    "kharij": { "alama": "لا_حكم" },
    "sanad": [],
    "taliq": "س145–148: لم يسكنوا ما صُيِّر من المتمكن بمنزلة غير المتمكن، ولم يسمِّ الباب الحركة"
  },
  {
    "id": "M30",
    "fia": "خارج",
    "mithal": "زيد",
    "mithal_harfi": false,
    "dakhil": { "sinf": "اسم_متمكن", "lafz": "", "mawdi": "بلا_عامل" },
    "kharij": { "alama": "لا_حكم" },
    "sanad": [],
    "taliq": "علامات المتمكن لما يحدث فيه العامل، ولم يذكر الباب آخرَه بلا عامل"
  },
  {
    "id": "M31",
    "fia": "عموم",
    "mithal": "مررت بالأحمر",
    "mithal_harfi": false,
    "dakhil": { "sinf": "اسم_لا_ينصرف_معرف", "lafz": "", "mawdi": "جر" },
    "kharij": { "alama": ["كسرة"], "bina": false },
    "sanad": [
      { "satr": 226, "nass": "وجميع ما لا ينصرف إذا أدخلت عليه الألف واللام أو" },
      { "satr": 227, "nass": "أضيف انجر" },
      { "satr": 228, "nass": "فيها الحر كما يدخل في المنصرف" }
    ],
    "taliq": "«جميع ما لا ينصرف … انجر» والجرّ كسرةٌ كما في المنصرف؛ «الحر» تصحيفُ الجرّ"
  },
  {
    "id": "M32",
    "fia": "عموم",
    "mithal": "من أين",
    "mithal_harfi": false,
    "dakhil": { "sinf": "غير_متمكن", "lafz": "أين", "mawdi": "جر" },
    "kharij": { "alama": ["فتحة"], "bina": true },
    "sanad": [
      { "satr": 116, "nass": "وبين ما" },
      { "satr": 117, "nass": "يبنى عليه الحرف بناء لا يزول عنه لغير شئ أحدث ذلك فيه من العوامل" },
      { "satr": 138, "nass": "فالفتح في الأسماء قولهم" },
      { "satr": 139, "nass": "حيث وأين وكيف" }
    ],
    "taliq": "البناء لا يزول بالعامل، فيبقى فتح أين في موضع الجرّ؛ المثال مركَّب"
  },
  {
    "id": "M33",
    "fia": "عموم",
    "mithal": "يفعلون",
    "mithal_harfi": true,
    "dakhil": { "sinf": "مضارع_جمع", "lafz": "", "mawdi": "رفع" },
    "kharij": { "alama": ["ثبات_النون"], "bina": false },
    "sanad": [
